<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>14cbbcba-2190-42a9-945c-fcd542751b94</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessSchool.ServiceDefaults\ChessSchool.ServiceDefaults.csproj" />
    <ProjectReference Include="..\ChessSchool.Contracts\ChessSchool.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <!-- Поднимаем транзитивную Microsoft.OpenApi 2.0.0 (high-severity GHSA-v5pm-xwqc-g5wc, NU1903:
         зацикленные схемы прерывают ПАРСИНГ OpenAPI) до первого пропатченного 2.7.5. Та же мажорная
         ветка 2.x (обратно совместима с 2.0.0, ожидаемой AspNetCore.OpenApi 10.0.8). У нас документ
         генерируется, а не парсится извне — эксплуатируемость низкая, но advisory закрываем. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

</Project>
