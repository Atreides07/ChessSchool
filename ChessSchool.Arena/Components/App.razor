@inject NavigationManager Nav
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ChessSchool.Arena.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/tournament.css"]" />
    <link rel="stylesheet" href="@Assets["css/pairings.css"]" />
    <link rel="stylesheet" href="@Assets["_content/ChessSchool.Design/css/design.css"]" />
    <link rel="alternate" hreflang="ru" href="@Alt("ru")" />
    <link rel="alternate" hreflang="en" href="@Alt("en")" />
    <link rel="alternate" hreflang="x-default" href="@Alt("ru")" />
    <ImportMap />
    <HeadOutlet />
    @* Полоса прогресса навигации (заполняется JS из navprogress.js) — обратная связь на медленном канале. *@
    <style>
        #nav-progress {
            position: fixed; top: 0; left: 0; height: 3px; width: 0; opacity: 0;
            background: var(--accent, #2b6ef2); box-shadow: 0 0 8px var(--accent, #2b6ef2);
            z-index: 9999; pointer-events: none;
        }
    </style>
</head>

@code {
    // hreflang-альтернативы: тот же URL с ?culture= — различимые языковые версии для краулеров.
    private string Alt(string culture)
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.GetLeftPart(UriPartial.Path);
        return $"{path}?culture={culture}";
    }
}

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* Скрипты-улучшения страниц грузим ГЛОБАЛЬНО один раз: при enhanced-навигации Blazor вставленный
       в новую страницу <script> НЕ исполняется, поэтому подключение на самой странице не запускалось
       (отсюда «пропала» кнопка/доска на /t/{id} при переходе с Home). Здесь скрипты живут постоянно и
       по событию enhancedload инициализируют свою страницу; на чужих страницах их setup() — no-op. *@
    <script src="@Assets["js/navprogress.js"]"></script>
    <script src="@Assets["js/premium.js"]"></script>
    <script src="@Assets["js/schedule.js"]"></script>
    <script src="@Assets["js/tournament.js"]"></script>
    <script src="@Assets["js/games.js"]"></script>
    <script src="@Assets["js/broadcast.js"]"></script>
    <script src="@Assets["js/pairings.js"]"></script>
</body>

</html>
