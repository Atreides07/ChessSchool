@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<input type="checkbox" id="ar-nav-toggle" class="ar-nav-toggle" />

<div class="ar-shell">
    <label for="ar-nav-toggle" class="ar-scrim"></label>

    <aside class="ar-side">
        <a class="ar-brand" href="/">
            <span class="ar-logo">
                <svg viewBox="0 0 45 45" width="18" height="18" fill="#fff"><path d="M18 10c1-1 3-2 5-2 7 0 12 6 12 16v14H13c0-6 3-9 7-12-2 1-5 2-7 1-2-1-2-3-1-5-2 1-4 1-5-1-1-3 1-5 4-7 .5-1 1-2 0-3 1-1 2-1 3 0z"/></svg>
            </span>
            ChessArena
        </a>

        <nav class="ar-nav">
            <NavLink class="ar-link" href="" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M6 4h12v4a6 6 0 01-12 0zM6 5H3v2a3 3 0 003 3M18 5h3v2a3 3 0 01-3 3" /></svg>Турниры «Арена»
            </NavLink>
        </nav>
    </aside>

    <div class="ar-main">
        <header class="ar-top">
            <label for="ar-nav-toggle" class="ar-burger" aria-label="Меню">
                <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </label>
            <div class="ar-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4-4" /></svg>
                <input type="search" placeholder="Поиск по турнирам" aria-label="Поиск" />
            </div>
            <span class="ar-spacer"></span>
            <AuthorizeView>
                <Authorized>
                    <ChessSchool.Design.UserMenu Name="@context.User.Identity?.Name"
                                                 Email='@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? context.User.FindFirst("email")?.Value)'
                                                 SignOutHref="/signout" />
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary btn-sm" href="/signin?returnUrl=/">Войти</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <main class="ar-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    /* ---------- Оболочка с сайдбаром (стиль idChess) ---------- */
    .ar-nav-toggle { display: none; }

    .ar-shell { min-height: 100vh; display: flex; background: var(--bg); }

    .ar-side {
        width: 256px; flex: none; background: var(--surface); border-right: 1px solid var(--line);
        position: sticky; top: 0; height: 100vh; padding: 18px 14px; display: flex; flex-direction: column;
        z-index: 40;
    }
    .ar-brand { display: flex; align-items: center; gap: .6rem; font-weight: 760; font-size: 1.18rem; letter-spacing: -.02em; color: var(--ink); padding: 6px 8px 18px; }
    .ar-brand:hover { color: var(--ink); }
    .ar-logo { width: 32px; height: 32px; display: grid; place-items: center; background: var(--ink); border-radius: 9px; }

    .ar-nav { display: flex; flex-direction: column; gap: 2px; }
    .ar-link { display: flex; align-items: center; gap: .7rem; padding: .62rem .7rem; border-radius: var(--r-md); color: var(--ink-2); font-weight: 560; font-size: .95rem; }
    .ar-link svg { width: 20px; height: 20px; flex: none; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ar-link:hover { background: var(--surface-2); color: var(--ink); }
    .ar-link.active { background: var(--surface-2); color: var(--ink); font-weight: 680; }

    .ar-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }

    .ar-top {
        position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 14px;
        padding: 14px 28px; background: rgba(255, 255, 255, .85); backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
    }
    .ar-burger { display: none; cursor: pointer; color: var(--ink-2); padding: 6px; border-radius: var(--r-sm); }
    .ar-burger svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; }
    .ar-burger:hover { background: var(--surface-2); }

    .ar-search { flex: 1; max-width: 560px; display: flex; align-items: center; gap: .5rem; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-pill); padding: .5rem .9rem; }
    .ar-search svg { width: 18px; height: 18px; stroke: var(--muted); fill: none; stroke-width: 1.8; stroke-linecap: round; flex: none; }
    .ar-search input { border: 0; background: transparent; outline: 0; width: 100%; font-size: .92rem; color: var(--ink); }

    .ar-spacer { flex: 1; }

    .ar-content { padding: 26px 28px 60px; width: 100%; max-width: 1200px; }

    /* ---------- Мобильный режим ---------- */
    .ar-scrim { display: none; }
    @@media (max-width: 900px) {
        .ar-burger { display: inline-grid; place-items: center; }
        .ar-side { position: fixed; top: 0; left: 0; bottom: 0; height: 100dvh; transform: translateX(-100%); transition: transform .22s ease; box-shadow: var(--shadow-lg); }
        .ar-nav-toggle:checked ~ .ar-shell .ar-side { transform: translateX(0); }
        .ar-nav-toggle:checked ~ .ar-shell .ar-scrim { display: block; position: fixed; inset: 0; background: rgba(14, 17, 22, .35); z-index: 35; }
        .ar-top { padding: 12px 16px; }
        .ar-content { padding: 18px 16px 48px; }
    }
</style>
