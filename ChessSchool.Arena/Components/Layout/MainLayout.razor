@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="ds-app">
    <header class="ds-topbar">
        <a class="ds-brand" href="/">
            <span class="logo">
                <svg viewBox="0 0 45 45" width="16" height="16" fill="#fff"><path d="M18 10c1-1 3-2 5-2 7 0 12 6 12 16v14H13c0-6 3-9 7-12-2 1-5 2-7 1-2-1-2-3-1-5-2 1-4 1-5-1-1-3 1-5 4-7 .5-1 1-2 0-3 1-1 2-1 3 0z"/></svg>
            </span>
            Arena
        </a>
        <nav class="ds-nav">
            <NavLink class="ds-navlink" href="" Match="NavLinkMatch.All">Турниры</NavLink>
        </nav>
        <span class="ds-spacer"></span>
        <AuthorizeView>
            <Authorized>
                <span class="badge badge-accent">@context.User.Identity?.Name</span>
                <a class="ds-navlink" href="/signout">Выйти</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary btn-sm" href="/signin?returnUrl=/">Войти</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="ds-container">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>
