@page "/broadcasts/{Slug}"
@using ChessSchool.Arena
@using ChessSchool.Arena.Services
@inject NavigationManager Nav
@inject IHttpContextAccessor Http
@inject BroadcastsCatalog Catalog

@* Отдельная индексируемая страница трансляции: свой URL, мета, schema.org Event + BreadcrumbList. Локализована. *@

@if (_t is null)
{
    <PageTitle>@(Loc.IsEn ? "Broadcast not found" : "Трансляция не найдена") — ChessArena</PageTitle>
    <HeadContent><meta name="robots" content="noindex" /></HeadContent>
    <div class="md-wrap">
        <p class="md-404">@Loc.T("detail.notfound")</p>
        <a class="md-back" href="broadcasts">@Loc.T("detail.all")</a>
    </div>
}
else
{
    var t = _t;
    var st = BroadcastFormat.Status(t);
    var ogImage = string.IsNullOrWhiteSpace(t.ImageUrl) ? $"{Nav.BaseUri}og-image.png" : t.ImageUrl;
    <PageTitle>@t.Name — @(Loc.IsEn ? "dates & venue" : "даты и место") | ChessArena</PageTitle>
    <HeadContent>
        <meta name="description" content="@MetaDescription(t)" />
        <meta name="robots" content="index,follow" />
        <link rel="canonical" href="@Canonical(t)" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@($"{t.Name} — {Loc.Tr(t.Series)}")" />
        <meta property="og:description" content="@MetaDescription(t)" />
        <meta property="og:url" content="@Canonical(t)" />
        <meta property="og:image" content="@ogImage" />
        <meta name="twitter:card" content="summary_large_image" />
        <script type="application/ld+json">@((MarkupString)JsonLd(t))</script>
    </HeadContent>

    <nav class="md-crumbs" aria-label="breadcrumb">
        <a href="">@Loc.T("crumb.home")</a><span>›</span>
        <a href="broadcasts">@Loc.T("crumb.broadcasts")</a><span>›</span>
        <span class="md-cur">@t.Name</span>
    </nav>

    <article class="md-card @st.Cls">
        @if (!string.IsNullOrWhiteSpace(t.ImageUrl))
        {
            <div class="md-hero @t.SeriesCls">
                <img class="md-img" src="@t.ImageUrl" alt="" aria-hidden="true"
                     loading="lazy" decoding="async" fetchpriority="low" referrerpolicy="no-referrer" />
            </div>
        }
        <div class="md-pad">
            <div class="md-row">
                <span class="mj-series @t.SeriesCls">@Loc.Tr(t.Series)</span>
                <span class="mj-status @st.Cls">@Loc.StatusLabel(st.Kind, st.Days)</span>
            </div>
            <h1 class="md-title">@t.Name</h1>
            <dl class="md-facts">
                <div><dt>@Loc.T("detail.dates")</dt><dd>@BroadcastFormat.LongDate(t.Start) – @BroadcastFormat.LongDate(t.End)</dd></div>
                <div><dt>@Loc.T("detail.place")</dt><dd>@t.Flag @Loc.Tr(t.City), @Loc.Tr(t.Country)</dd></div>
                <div><dt>@Loc.T("detail.format")</dt><dd>@Loc.Tr(t.Format)</dd></div>
                <div><dt>@Loc.T("detail.series")</dt><dd>@Loc.Tr(t.Series)</dd></div>
            </dl>
            <div class="md-actions">
                @if (!string.IsNullOrWhiteSpace(t.Url))
                {
                    <a class="btn btn-primary btn-sm" href="@t.Url" target="_blank" rel="noopener noreferrer">@Loc.T("detail.site")</a>
                }
                <a class="md-back" href="broadcasts">@Loc.T("detail.all")</a>
            </div>
        </div>
    </article>

    @if (!string.IsNullOrWhiteSpace(t.PgnUrl))
    {
        var liveCfg = new
        {
            slug = t.Slug,
            loc = new
            {
                live = Loc.T("detail.boards.live"),
                ongoing = Loc.T("detail.boards.ongoing"),
                moves = Loc.T("detail.boards.moves"),
                empty = Loc.T("detail.boards.empty"),
                error = Loc.T("detail.boards.error"),
            },
        };
        @* Онлайн-доски трансляции — прогрессивное улучшение поверх SEO-каркаса: тонкий клиент тянет
           разобранный PGN с /api/broadcasts/{slug}/games[/n] и рисует доски из FEN без внешних библиотек
           (исходящий HTTP — в minimal-API, не в рендере; грабля #12). Доска открывается оверлеем с навигацией по ходам. *@
        <section class="bd-live" aria-label="@Loc.T("detail.boards")">
            <h2 class="bd-live-h">@Loc.T("detail.boards")</h2>
            <div id="bd-boards" class="bd-grid"><p class="bd-muted">@Loc.T("detail.boards.loading")</p></div>
        </section>

        <div id="bd-overlay" class="bd-overlay" hidden>
            <div class="bd-modal" role="dialog" aria-modal="true">
                <button id="bd-close" class="bd-close" aria-label="@Loc.T("detail.boards.close")">✕</button>
                <div class="bd-modal-grid">
                    <div class="bd-board-col">
                        <div class="bd-player" id="bd-top"></div>
                        <div class="board-wrap"><div id="bd-board" class="board"></div></div>
                        <div class="bd-player" id="bd-bottom"></div>
                        <div class="bd-controls">
                            <button class="btn btn-sm btn-outline" id="bd-first" aria-label="⏮">⏮</button>
                            <button class="btn btn-sm btn-outline" id="bd-prev" aria-label="◀">◀</button>
                            <span class="bd-counter" id="bd-counter">0 / 0</span>
                            <button class="btn btn-sm btn-outline" id="bd-next" aria-label="▶">▶</button>
                            <button class="btn btn-sm btn-outline" id="bd-last" aria-label="⏭">⏭</button>
                        </div>
                    </div>
                    <div class="bd-side">
                        <div id="bd-result" class="bd-result"></div>
                        <div id="bd-moves" class="bd-moves"></div>
                    </div>
                </div>
            </div>
        </div>

        <script type="module">
            const CFG = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(liveCfg, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
            const L = CFG.loc;
            const POLL_MS = 12000;
            const files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
            const esc = (s) => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
            const gamesUrl = () => `/api/broadcasts/${encodeURIComponent(CFG.slug)}/games`;
            const boardUrl = (n) => `${gamesUrl()}/${n}`;

            const pieceImg = (ch) => {
                const color = ch === ch.toUpperCase() ? 'w' : 'b';
                return `<img class="cp" draggable="false" alt="" src="_content/ChessSchool.Design/pieces/${color}${ch.toUpperCase()}.svg">`;
            };
            function parseFen(fen) {
                const map = {};
                const rows = (fen || '').split(' ')[0].split('/');
                for (let r = 0; r < 8; r++) {
                    let file = 0;
                    for (const ch of rows[r] || '') {
                        if (ch >= '1' && ch <= '8') file += +ch;
                        else { map[files[file] + (8 - r)] = ch; file++; }
                    }
                }
                return map;
            }

            // --- Сетка досок ---
            const gridEl = document.getElementById('bd-boards');

            function miniBoard(fen, from, to) {
                const pos = parseFen(fen);
                let html = '';
                for (let r = 8; r >= 1; r--) for (let fi = 0; fi < 8; fi++) {
                    const f = files[fi], sq = f + r, dark = (fi + r) % 2 === 0;
                    const hl = (sq === from || sq === to) ? ' hl' : '';
                    const ch = pos[sq];
                    html += `<div class="bd-msq ${dark ? 'd' : 'l'}${hl}">${ch ? pieceImg(ch) : ''}</div>`;
                }
                return `<div class="bd-mini">${html}</div>`;
            }

            function nameLine(name, elo) {
                return `<span class="bd-pl-name">${esc(name)}</span>${elo ? `<span class="bd-pl-elo">${esc(elo)}</span>` : ''}`;
            }

            function gameCard(b) {
                const tag = b.finished
                    ? `<span class="bd-tag done">${esc(b.result)}</span>`
                    : `<span class="bd-tag live">● ${esc(L.live)}</span>`;
                return `<button class="bd-card" data-board="${b.board}">
                    <div class="bd-card-top"><span class="bd-bn">#${b.board}</span>${tag}</div>
                    ${miniBoard(b.fen, b.lastFrom, b.lastTo)}
                    <div class="bd-card-pl">${nameLine(b.black, b.blackElo)}</div>
                    <div class="bd-card-pl">${nameLine(b.white, b.whiteElo)}</div>
                </button>`;
            }

            async function loadGrid() {
                let data;
                try {
                    const r = await fetch(gamesUrl(), { credentials: 'include' });
                    if (r.status === 404) { gridEl.innerHTML = `<p class="bd-muted">${esc(L.empty)}</p>`; return; }
                    if (!r.ok) { gridEl.innerHTML = `<p class="bd-muted">${esc(L.error)}</p>`; return; }
                    data = await r.json();
                } catch { gridEl.innerHTML = `<p class="bd-muted">${esc(L.error)}</p>`; return; }

                const boards = data.boards || [];
                if (!boards.length) { gridEl.innerHTML = `<p class="bd-muted">${esc(L.empty)}</p>`; return; }
                gridEl.innerHTML = boards.map(gameCard).join('');
                gridEl.querySelectorAll('[data-board]').forEach(b => b.onclick = () => openBoard(+b.dataset.board));
            }

            // --- Оверлей одной доски с навигацией по ходам ---
            const overlayEl = document.getElementById('bd-overlay');
            const boardEl = document.getElementById('bd-board');
            const movesEl = document.getElementById('bd-moves');
            const counterEl = document.getElementById('bd-counter');
            const resultEl = document.getElementById('bd-result');
            const cells = {}, coordHtml = {};
            let openId = null, fens = [], froms = [], tos = [], sans = [], total = 0, ply = 0;

            function buildBoard() {
                boardEl.innerHTML = '';
                for (let r = 8; r >= 1; r--) for (let fi = 0; fi < 8; fi++) {
                    const f = files[fi], sq = f + r, dark = (fi + r) % 2 === 0, tone = dark ? 'on-dark' : 'on-light';
                    const el = document.createElement('div');
                    el.className = 'sq ' + (dark ? 'dark' : 'light');
                    let cd = '';
                    if (fi === 0) cd += `<span class="coord rank ${tone}">${r}</span>`;
                    if (r === 1) cd += `<span class="coord file ${tone}">${f}</span>`;
                    coordHtml[sq] = cd;
                    boardEl.appendChild(el);
                    cells[sq] = el;
                }
            }

            function renderBoard() {
                const pos = parseFen(fens[ply]);
                for (const f of files) for (let r = 1; r <= 8; r++) {
                    const sq = f + r, el = cells[sq], ch = pos[sq];
                    el.innerHTML = coordHtml[sq] + (ch ? pieceImg(ch) : '');
                    el.classList.remove('hl');
                }
                if (froms[ply] && cells[froms[ply]]) cells[froms[ply]].classList.add('hl');
                if (tos[ply] && cells[tos[ply]]) cells[tos[ply]].classList.add('hl');
                counterEl.textContent = `${ply} / ${total}`;
                movesEl.querySelectorAll('.bd-cell').forEach(c => c.classList.toggle('on', +c.dataset.ply === ply));
                const onCell = movesEl.querySelector('.bd-cell.on');
                if (onCell) onCell.scrollIntoView({ block: 'nearest' });
            }

            function renderMoves() {
                let html = '';
                for (let n = 1; n <= Math.ceil(total / 2); n++) {
                    const w = 2 * n - 1, bl = 2 * n;
                    html += `<span class="bd-rownum">${n}.</span>`;
                    html += `<button class="bd-cell" data-ply="${w}">${esc(sans[w] || '')}</button>`;
                    html += bl <= total ? `<button class="bd-cell" data-ply="${bl}">${esc(sans[bl] || '')}</button>` : `<span></span>`;
                }
                movesEl.innerHTML = html;
                movesEl.querySelectorAll('.bd-cell').forEach(c => c.onclick = () => { ply = +c.dataset.ply; renderBoard(); });
            }

            function setGame(d) {
                const plies = d.plies || [];
                const atEnd = ply === total; // следим за «живым» концом, чтобы подтягивать новые ходы
                fens = [d.startFen, ...plies.map(p => p.fen)];
                froms = [null, ...plies.map(p => p.from)];
                tos = [null, ...plies.map(p => p.to)];
                sans = [null, ...plies.map(p => p.san)];
                const wasTotal = total;
                total = plies.length;
                if (openId !== d.board || ply > total || (atEnd && total !== wasTotal)) ply = total;
                document.getElementById('bd-top').innerHTML = nameLine(d.black, d.blackElo);
                document.getElementById('bd-bottom').innerHTML = nameLine(d.white, d.whiteElo);
                const ongoing = !(d.result === '1-0' || d.result === '0-1' || d.result === '1/2-1/2');
                resultEl.textContent = ongoing ? L.ongoing : d.result;
                resultEl.className = 'bd-result ' + (ongoing ? 'live' : 'done');
                renderMoves();
                renderBoard();
            }

            async function fetchBoard(n) {
                const r = await fetch(boardUrl(n), { credentials: 'include' });
                if (!r.ok) return null;
                return await r.json();
            }

            async function openBoard(n) {
                const d = await fetchBoard(n);
                if (!d) return;
                openId = n;
                ply = -1; // setGame переустановит на конец при первой загрузке
                total = -1;
                setGame(d);
                overlayEl.hidden = false;
                document.body.style.overflow = 'hidden';
            }

            function closeOverlay() { overlayEl.hidden = true; openId = null; document.body.style.overflow = ''; }
            document.getElementById('bd-close').onclick = closeOverlay;
            overlayEl.onclick = (e) => { if (e.target === overlayEl) closeOverlay(); };
            document.addEventListener('keydown', (e) => {
                if (overlayEl.hidden) return;
                if (e.key === 'Escape') closeOverlay();
                else if (e.key === 'ArrowLeft') { if (ply > 0) { ply--; renderBoard(); } }
                else if (e.key === 'ArrowRight') { if (ply < total) { ply++; renderBoard(); } }
            });
            document.getElementById('bd-first').onclick = () => { ply = 0; renderBoard(); };
            document.getElementById('bd-prev').onclick = () => { if (ply > 0) { ply--; renderBoard(); } };
            document.getElementById('bd-next').onclick = () => { if (ply < total) { ply++; renderBoard(); } };
            document.getElementById('bd-last').onclick = () => { ply = total; renderBoard(); };

            buildBoard();
            loadGrid();
            setInterval(async () => {
                await loadGrid();
                if (!overlayEl.hidden && openId !== null) { const d = await fetchBoard(openId); if (d) setGame(d); }
            }, POLL_MS);
        </script>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Broadcast? _t;

    protected override async Task OnInitializedAsync()
    {
        _t = await Catalog.BySlugAsync(Slug);
        // Скрытая трансляция не должна индексироваться/открываться по прямой ссылке как контент.
        if (_t is { Visible: false }) _t = null;
        if (_t is null && Http.HttpContext is { } ctx && !ctx.Response.HasStarted)
            ctx.Response.StatusCode = 404;
    }

    private string Canonical(Broadcast t) => $"{Nav.BaseUri}broadcasts/{t.Slug}";

    private string MetaDescription(Broadcast t)
    {
        var dates = $"{BroadcastFormat.LongDate(t.Start)} – {BroadcastFormat.LongDate(t.End)}";
        var place = $"{Loc.Tr(t.City)}, {Loc.Tr(t.Country)}";
        return Loc.IsEn
            ? $"{t.Name} ({Loc.Tr(t.Series)}): {dates}, {place}. Format: {Loc.Tr(t.Format)}."
            : $"{t.Name} ({Loc.Tr(t.Series)}): {dates}, {place}. Формат: {Loc.Tr(t.Format)}.";
    }

    private string JsonLd(Broadcast t)
    {
        var graph = new object[]
        {
            new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org", ["@type"] = "Event",
                ["name"] = t.Name,
                ["startDate"] = t.Start.ToString("yyyy-MM-dd"),
                ["endDate"] = t.End.ToString("yyyy-MM-dd"),
                ["eventAttendanceMode"] = "https://schema.org/OfflineEventAttendanceMode",
                ["eventStatus"] = "https://schema.org/EventScheduled",
                ["location"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Place",
                    ["name"] = $"{Loc.Tr(t.City)}, {Loc.Tr(t.Country)}",
                    ["address"] = $"{Loc.Tr(t.City)}, {Loc.Tr(t.Country)}",
                },
                ["url"] = Canonical(t),
                ["image"] = string.IsNullOrWhiteSpace(t.ImageUrl) ? $"{Nav.BaseUri}og-image.png" : t.ImageUrl,
            },
            new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org", ["@type"] = "BreadcrumbList",
                ["itemListElement"] = new object[]
                {
                    new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = Loc.T("crumb.home"), ["item"] = Nav.BaseUri },
                    new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = Loc.T("crumb.broadcasts"), ["item"] = $"{Nav.BaseUri}broadcasts" },
                    new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = t.Name, ["item"] = Canonical(t) },
                },
            },
        };
        return System.Text.Json.JsonSerializer.Serialize(graph, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        });
    }
}

<style>
    .md-wrap { padding: 1rem 0; }
    .md-404 { color: var(--ink-2); }
    .md-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; font-size: .9rem; color: var(--ink-2); margin-bottom: 1.1rem; }
    .md-crumbs a { color: var(--ink-2); font-weight: 600; }
    .md-crumbs a:hover { color: var(--accent); }
    .md-crumbs span { color: var(--muted); }
    .md-crumbs .md-cur { color: var(--ink); font-weight: 600; }

    .md-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); max-width: 640px; overflow: hidden; }
    .md-card.live { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); }

    /* Геро-изображение: фиксированный aspect-ratio (нет CLS), lazy/async — не блокирует контент. */
    .md-hero { position: relative; aspect-ratio: 16 / 6; width: 100%; overflow: hidden; }
    .md-hero.gct { background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 22%, var(--surface)), var(--surface)); }
    .md-hero.cls { background: linear-gradient(135deg, var(--surface-2), var(--surface)); }
    .md-hero.wom { background: linear-gradient(135deg, #fbe6f1, var(--surface)); }
    .md-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

    .md-pad { padding: 1.4rem 1.5rem; }
    .md-row { display: flex; align-items: center; gap: .6rem; margin-bottom: .6rem; }
    .md-title { font-size: 1.7rem; font-weight: 800; letter-spacing: -.02em; color: var(--ink); margin: 0 0 1rem; line-height: 1.2; }

    .md-facts { display: grid; grid-template-columns: 1fr; gap: .55rem; margin: 0 0 1.2rem; }
    .md-facts > div { display: flex; gap: .8rem; }
    .md-facts dt { width: 86px; flex: none; color: var(--muted); font-size: .9rem; }
    .md-facts dd { margin: 0; color: var(--ink); font-weight: 600; }

    .md-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .md-back { color: var(--ink-2); font-weight: 600; font-size: .92rem; }
    .md-back:hover { color: var(--accent); }

    /* --- Онлайн-доски трансляции --- */
    .bd-live { margin-top: 2rem; }
    .bd-live-h { font-size: 1.3rem; font-weight: 760; color: var(--ink); margin: 0 0 1rem; }
    .bd-muted { color: var(--ink-2); }

    .bd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
    .bd-card { display: flex; flex-direction: column; gap: .4rem; padding: .7rem; text-align: left; cursor: pointer;
               background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--shadow-sm);
               transition: box-shadow .15s ease, transform .15s ease; font: inherit; }
    .bd-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .bd-card-top { display: flex; align-items: center; justify-content: space-between; }
    .bd-bn { font-size: .8rem; font-weight: 700; color: var(--muted); }
    .bd-tag { font-size: .72rem; font-weight: 800; padding: .1rem .45rem; border-radius: var(--r-pill); }
    .bd-tag.live { background: #fde7e7; color: #c0392b; }
    .bd-tag.done { background: var(--surface-2); color: var(--ink-2); }
    .bd-card-pl { display: flex; align-items: baseline; gap: .4rem; font-size: .85rem; min-width: 0; }
    .bd-pl-name { color: var(--ink); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bd-pl-elo { color: var(--muted); font-size: .78rem; flex: none; }

    .bd-mini { display: grid; grid-template-columns: repeat(8, 1fr); aspect-ratio: 1 / 1; width: 100%;
               border-radius: 4px; overflow: hidden; }
    .bd-msq { display: flex; align-items: center; justify-content: center; }
    .bd-msq.l { background: #ecd6b3; }
    .bd-msq.d { background: #b58863; }
    .bd-msq.hl.l { background: #cdd279; }
    .bd-msq.hl.d { background: #aaa23a; }
    .bd-mini .cp { width: 100%; height: 100%; display: block; }

    /* --- Оверлей одной доски --- */
    .bd-overlay { position: fixed; inset: 0; z-index: 50; background: rgba(15, 18, 22, .55);
                  display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .bd-overlay[hidden] { display: none; }
    .bd-modal { position: relative; background: var(--surface); border-radius: var(--r-lg); box-shadow: 0 16px 48px rgba(0,0,0,.3);
                padding: 1.4rem; max-width: 900px; width: 100%; max-height: 92vh; overflow: auto; }
    .bd-close { position: absolute; top: .7rem; right: .8rem; border: none; background: transparent; font-size: 1.2rem;
                color: var(--ink-2); cursor: pointer; line-height: 1; }
    .bd-close:hover { color: var(--ink); }
    .bd-modal-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 240px); gap: 1.4rem; align-items: start; }
    .bd-board-col { display: flex; flex-direction: column; gap: .5rem; }
    .bd-player { font-weight: 640; color: var(--ink); display: flex; align-items: baseline; gap: .4rem; }
    .bd-controls { display: flex; align-items: center; gap: .4rem; justify-content: center; margin-top: .3rem; }
    .bd-counter { font-variant-numeric: tabular-nums; font-size: .9rem; color: var(--ink-2); min-width: 56px; text-align: center; }
    .bd-side { display: flex; flex-direction: column; gap: .7rem; min-width: 0; }
