@page "/"
@inject IGrainFactory Grains

<PageTitle>Arena — турниры</PageTitle>
<HeadContent>
    <meta name="description" content="Арена-турниры по шахматам: bullet, blitz, rapid. Непрерывный пейринг и стрики, как на lichess." />
</HeadContent>

<div class="section-head">
    <div>
        <h1>Турниры</h1>
        <p class="text-secondary mb-0">Арена с непрерывным пейрингом и стриками. Единый аккаунт ChessSchool ID.</p>
    </div>
</div>

@if (_tournaments is null)
{
    <p class="text-muted"><em>Загрузка…</em></p>
}
else
{
    <div class="grid grid-auto">
        @foreach (var t in _tournaments)
        {
            <a class="tcard" href="/t/@t.Id">
                <div class="row between">
                    <span class="ttitle">@t.Name</span>
                    <span class="badge @StatusBadge(t.Status)">@StatusText(t.Status)</span>
                </div>
                <div class="tmeta">
                    <span>@t.TimeControl</span>
                    <span>@t.PlayerCount участников</span>
                </div>
                @if (t.Status == TournamentStatus.Running)
                {
                    <div class="tmeta"><span>Осталось ~@(t.SecondsLeft / 60) мин</span></div>
                }
            </a>
        }
    </div>
}

@code {
    private IReadOnlyList<TournamentSummaryDto>? _tournaments;

    protected override async Task OnInitializedAsync() =>
        _tournaments = await Grains.GetGrain<IArenaDirectoryGrain>(0).ListAsync();

    private static string StatusText(TournamentStatus s) => s switch
    {
        TournamentStatus.Running => "идёт",
        TournamentStatus.Finished => "завершён",
        _ => "скоро"
    };

    private static string StatusBadge(TournamentStatus s) => s switch
    {
        TournamentStatus.Running => "badge-success",
        TournamentStatus.Finished => "",
        _ => "badge-warn"
    };
}

<style>
    .tcard { display: block; padding: 18px; border-radius: var(--r-lg); background: var(--surface); color: var(--ink); text-decoration: none; border: 1px solid var(--line); box-shadow: var(--shadow-sm); transition: box-shadow .12s, border-color .12s, transform .12s; }
    .tcard:hover { box-shadow: var(--shadow-md); border-color: var(--line-strong); transform: translateY(-1px); color: var(--ink); }
    .ttitle { font-size: 1.1rem; font-weight: 660; }
    .tmeta { display: flex; justify-content: space-between; margin-top: .6rem; color: var(--muted); font-size: .9rem; }
</style>
