@page "/"
@using ChessSchool.Arena
@inject IGrainFactory Grains
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject ChessSchool.Arena.Services.BrandTournamentCatalog BrandCatalog

<PageTitle>Расписание арена-турниров — ChessArena</PageTitle>
<HeadContent>
    <meta name="description" content="Расписание шахматных арена-турниров: bullet, blitz, rapid. Непрерывный пейринг и стрики." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@Nav.BaseUri" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ChessArena — арена-турниры в реальном времени" />
    <meta property="og:description" content="Расписание шахматных арена-турниров: bullet, blitz, rapid. Непрерывный пейринг и стрики." />
    <meta property="og:url" content="@Nav.BaseUri" />
    <meta property="og:image" content="@($"{Nav.BaseUri}og-image.png")" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">
        {"@@context":"https://schema.org","@@type":"WebSite","name":"ChessArena","url":"@Nav.BaseUri"}
    </script>
</HeadContent>

@if (_tournaments is null)
{
    <p class="text-muted"><em>@Loc.T("loading")</em></p>
}
else
{
    <div class="sched">
        @* Состояние переключателя вида: выбор запоминается в cookie (schedview) и восстанавливается
           сервером при навигации; мгновенное переключение — на CSS, запись cookie — в schedule.js. *@
        <input type="radio" name="schedview" id="sv-tl" class="sv-state" checked="@(!_listView)" />
        <input type="radio" name="schedview" id="sv-list" class="sv-state" checked="@_listView" />

        <div class="sched-top">
            <div>
                <div class="sched-status">
                    <span class="dot"></span>@_liveCount @Loc.T("sched.livenow") · @_dateLabel
                </div>
                <h1>@Loc.T("sched.title")</h1>
            </div>

            <div class="sched-controls">
                <div class="seg seg-view">
                    <label for="sv-tl">
                        <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h10" /></svg>@Loc.T("view.timeline")
                    </label>
                    <label for="sv-list">
                        <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>@Loc.T("view.list")
                    </label>
                </div>

                <div class="sched-filters">
                    <span class="now-pill">
                        <button type="button" class="chev" data-tl-scroll="-1" aria-label="@Loc.T("ctl.back")">‹</button>
                        <button type="button" class="now-btn" data-tl-now>@Loc.T("ctl.now")</button>
                        <button type="button" class="chev" data-tl-scroll="1" aria-label="@Loc.T("ctl.fwd")">›</button>
                    </span>
                    <div class="seg seg-range" role="group" aria-label="@Loc.T("ctl.scale")">
                        <button type="button" class="rng" data-tl-zoom="1">1ч</button>
                        <button type="button" class="rng is-active" data-tl-zoom="4">4ч</button>
                        <button type="button" class="rng" data-tl-zoom="12">12ч</button>
                    </div>
                </div>
            </div>
        </div>

        @* ---------------- Лента «Главные турниры» (всегда сверху) ---------------- *@
        @if (_brand.Count > 0)
        {
            var featured = _brand.Take(4).ToList();
            <div class="bt-rail">
                @foreach (var v in featured)
                {
                    var pill = BrandPill(v);
                    var slug = v.Brand.Slug;
                    var longDesc = (v.Brand.Description?.Length ?? 0) > 90;
                    var (ctaHref, ctaLabel) = v.Summary.Status switch
                    {
                        TournamentStatus.Running => ($"/t/{slug}", Loc.T("bt.watch")),
                        TournamentStatus.Created => ($"/t/{slug}/calendar.ics", Loc.T("bt.remind")),
                        _ => ($"/t/{slug}", Loc.T("bt.results")),
                    };
                    <div class="bt-rcard">
                        <a class="bt-rbanner bt-@pill.Cls" href="/t/@slug" aria-label="@v.Brand.Name">
                            @if (!string.IsNullOrWhiteSpace(v.Brand.ImageUrl))
                            {
                                <img class="bt-rimg" src="@v.Brand.ImageUrl" alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span class="bt-rstar">★</span>
                            }
                            <span class="bt-rpill bt-@pill.Cls">@pill.Label</span>
                        </a>
                        <div class="bt-rbody">
                            <a class="bt-rname" href="/t/@slug">@v.Brand.Name</a>
                            @if (!string.IsNullOrWhiteSpace(v.Brand.Description))
                            {
                                <span class="bt-rdesc">@v.Brand.Description</span>
                                @if (longDesc)
                                {
                                    <label class="bt-readmore" for="bd-@slug">@Loc.T("bt.readmore")</label>
                                }
                            }
                            <span class="bt-rfoot">
                                <span class="bt-rwhen">@(v.Summary.Status == TournamentStatus.Running ? Loc.MinutesLeft(v.Summary.SecondsLeft / 60) : v.Brand.StartsAt.ToLocalTime().ToString("dd.MM HH:mm"))</span>
                                <a class="bt-rcta" href="@ctaHref">@ctaLabel →</a>
                            </span>
                        </div>
                    </div>
                }

                @* Полное описание во всплывающей модалке (CSS-only: чекбокс + label, без JS — работает на статическом SSR) *@
                @foreach (var v in featured.Where(v => (v.Brand.Description?.Length ?? 0) > 90))
                {
                    var slug = v.Brand.Slug;
                    <input type="checkbox" id="bd-@slug" class="bt-dtoggle" />
                    <div class="bt-dmodal">
                        <label class="bt-dmodal-bg" for="bd-@slug" aria-label="@Loc.T("bt.close")"></label>
                        <div class="bt-dmodal-box" role="dialog" aria-label="@v.Brand.Name">
                            <h3 class="bt-dmodal-t">@v.Brand.Name</h3>
                            <p class="bt-dmodal-d">@v.Brand.Description</p>
                            <label class="bt-dmodal-close" for="bd-@slug">@Loc.T("bt.close")</label>
                        </div>
                    </div>
                }
            </div>
        }

        @* ---------------- Таймлайн (десктоп) ---------------- *@
        <div class="view view-tl">
            <div class="tl-wrap">
                <div class="tl-scroll" data-tl-scrollarea>
                    <div class="tl-grid" data-tl-grid data-start="@_windowStartUnix" style="--cols:@(Hours * 2); --colw:92px">
                        <div class="tl-gutter"></div>
                        @for (var h = 0; h < Hours; h++)
                        {
                            var hour = (_startHour + h + 24) % 24;
                            <div class="tl-h" style="grid-column:@(h * 2 + 2) / span 2">@hour.ToString("00"):00</div>
                        }

                        @foreach (var b in _blocks)
                        {
                            <a class='tlb @b.Type tlb-@b.State @(b.Mine ? "tlb-mine" : "")' href="/t/@b.Id"
                               style="grid-column:@(b.Col) / span @(b.Span); grid-row:@(b.Row)"
                               title="@BlockTitle(b)">
                                <div class="tlb-head">
                                    <span class="tlb-title">
                                        @if (b.State == "live")
                                        {
                                            <span class="live"></span>
                                        }
                                        <span class="tlb-ico">@Icon(b.Type)</span>@b.Title
                                        @if (b.Mine)
                                        {
                                            <span class="mine-badge" title="@Loc.T("mine.title")">★</span>
                                        }
                                    </span>
                                    <span class="tlb-tc">@b.Tc</span>
                                </div>
                                <div class="tlb-sub">
                                    <span>@b.Time</span>
                                    <span class="tlb-pop">@b.Humans 👤 @b.Bots 🤖</span>
                                </div>
                            </a>
                        }

                        <div class="tl-now" data-tl-nowline><span class="tl-now-label" data-tl-nowlabel></span></div>
                    </div>
                </div>
            </div>
        </div>

        @* ---------------- Список (десктоп): разделы по статусу, последовательно ---------------- *@
        <div class="view view-list">
            @{
                RenderFragment<TournamentSummaryDto> card = t =>
                    @<a class='lcard @TypeOf(t.TimeControl) lcard-@StateOf(t.Status) @(t.Joined ? "lcard-mine" : "")' href="/t/@t.Id">
                        <div class="lcard-head">
                            <span class="tlb-ico">@Icon(TypeOf(t.TimeControl))</span>
                            <span class="lcard-title">@t.Name</span>
                            @if (t.Joined)
                            {
                                <span class="badge badge-mine">@Loc.T("mine.badge")</span>
                            }
                            <span class="badge @StatusBadge(t.Status)">@StatusText(t.Status)</span>
                        </div>
                        <div class="lcard-meta">
                            <span>@t.StartsAt.ToLocalTime().ToString("HH:mm")</span>
                            <span>@t.HumanCount 👤 @Loc.T("unit.players")</span>
                            <span>@t.BotCount 🤖 @Loc.T("unit.bots")</span>
                            @if (t.Status == TournamentStatus.Running)
                            {
                                <span>@Loc.MinutesLeft(t.SecondsLeft / 60)</span>
                            }
                        </div>
                    </a>;
            }

            @if (_brand.Count > 0)
            {
                <div class="lcat"><span>★ @Loc.T("bt.featured")</span></div>
                <div class="lgrid">
                    @foreach (var v in _brand)
                    {
                        <a class="lcard brand lcard-@StateOf(v.Summary.Status)" href="/t/@v.Brand.Slug">
                            <div class="lcard-head">
                                <span class="tlb-ico">★</span>
                                <span class="lcard-title">@v.Brand.Name</span>
                                <span class="badge @StatusBadge(v.Summary.Status)">@StatusText(v.Summary.Status)</span>
                            </div>
                            <div class="lcard-meta">
                                <span>@v.Brand.StartsAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                <span>@v.Summary.HumanCount 👤 @Loc.T("unit.players")</span>
                                <span>@v.Summary.BotCount 🤖 @Loc.T("unit.bots")</span>
                            </div>
                        </a>
                    }
                </div>
            }
            @if (_running.Count > 0)
            {
                <div class="lcat @(_brand.Count > 0 ? "lcat-gap" : "")"><span>@Loc.T("cat.running")</span></div>
                <div class="lgrid">@foreach (var t in _running) { @card(t) }</div>
            }
            @if (_next.Count > 0)
            {
                <div class="lcat lcat-gap"><span>@Loc.T("cat.next")</span></div>
                <div class="lgrid">@foreach (var t in _next) { @card(t) }</div>
            }
            @if (_finished.Count > 0)
            {
                <div class="lcat lcat-gap"><span>@Loc.T("cat.finished")</span></div>
                <div class="lgrid">@foreach (var t in _finished) { @card(t) }</div>
            }
        </div>

        @* ---------------- Мобайл: только список предстоящих ---------------- *@
        <div class="sched-mobile">
            @if (_brand.Count > 0)
            {
                <div class="lcat"><span>★ @Loc.T("bt.featured")</span></div>
                <div class="up-list" style="margin-bottom:18px">
                    @foreach (var v in _brand)
                    {
                        <a class="up-item brand" href="/t/@v.Brand.Slug">
                            <span class="up-time">@v.Brand.StartsAt.ToLocalTime().ToString("HH:mm")</span>
                            <span class="tlb-ico">★</span>
                            <span class="up-title">@v.Brand.Name</span>
                            <span class="badge @StatusBadge(v.Summary.Status)">@StatusText(v.Summary.Status)</span>
                        </a>
                    }
                </div>
            }
            <div class="lcat"><span>@Loc.T("cat.upcoming")</span></div>
            @if (_upcoming.Count == 0)
            {
                <p class="text-muted">@Loc.T("empty.upcoming")</p>
            }
            else
            {
                <div class="up-list">
                    @foreach (var t in _upcoming)
                    {
                        <a class='up-item @TypeOf(t.TimeControl) @(t.Joined ? "up-mine" : "")' href="/t/@t.Id">
                            <span class="up-time">@t.StartsAt.ToLocalTime().ToString("HH:mm")</span>
                            <span class="tlb-ico">@Icon(TypeOf(t.TimeControl))</span>
                            <span class="up-title">@t.Name</span>
                            <span class="up-pop">@t.HumanCount 👤 @t.BotCount 🤖</span>
                            <span class='badge @(t.Joined ? "badge-mine" : "badge-warn")'>@(t.Joined ? Loc.T("mine.you") : Loc.T("reg.short"))</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

@* Прогрессивное улучшение таймлайна (now-линия, зум, скролл) *@
<script src="js/schedule.js"></script>

@code {
    private const int WindowBackHours = 3;
    private const int Hours = 9; // 3 назад + 6 вперёд (совпадает с расписанием в ArenaDirectoryGrain)

    private IReadOnlyList<TournamentSummaryDto>? _tournaments;
    private readonly List<Block> _blocks = new();
    private readonly List<TournamentSummaryDto> _upcoming = new();
    private readonly List<TournamentSummaryDto> _running = new();   // текущие
    private readonly List<TournamentSummaryDto> _next = new();      // следующие
    private readonly List<TournamentSummaryDto> _finished = new();  // завершённые
    private int _startHour;
    private long _windowStartUnix;
    private int _liveCount;
    private string _dateLabel = "";
    private bool _listView; // выбранный вид (из cookie) — список вместо таймлайна

    private IReadOnlyList<BrandTournamentView> _brand = [];   // «Главные турниры» (лента/дорожка/список)
    private readonly List<Block> _brandBlocks = new();        // бренд-блоки таймлайна (верхняя дорожка)
    private int _laneOffset;                                  // 1, если в окне есть бренд-дорожка

    private sealed record Block(string Id, int Col, int Span, int Row, string Type, string Title,
        string Time, int Humans, int Bots, string Tc, string State, bool Mine);

    protected override async Task OnInitializedAsync()
    {
        // Выбранный вид расписания из cookie (переживает навигацию на турнир и обратно).
        _listView = Http.HttpContext?.Request.Cookies["schedview"] == "list";

        // sub текущего пользователя (тот же, с которым он присоединяется к турниру).
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var sub = user.Identity?.IsAuthenticated == true
            ? user.FindFirst("sub")?.Value ?? user.Identity.Name
            : null;

        _tournaments = await Grains.GetGrain<IArenaDirectoryGrain>(0).ListAsync(sub);
        _liveCount = _tournaments.Count(t => t.Status == TournamentStatus.Running);

        // Бренд-турниры («Главные») — отдельный каталог + живые сводки грейнов.
        _brand = await BrandCatalog.ListWithSummaryAsync(sub);

        var now = DateTimeOffset.Now;
        _dateLabel = Loc.DateLabel(now);

        var windowStart = new DateTimeOffset(now.Year, now.Month, now.Day, now.Hour, 0, 0, now.Offset)
            .AddHours(-WindowBackHours);
        _startHour = windowStart.Hour;
        _windowStartUnix = windowStart.ToUnixTimeSeconds();

        BuildBrandBlocks(windowStart); // верхняя дорожка + сдвиг регулярных лейнов (если бренд в окне)
        BuildTimeline(windowStart);
        _blocks.AddRange(_brandBlocks);

        _upcoming.AddRange(_tournaments
            .Where(t => t.Status == TournamentStatus.Created)
            .OrderBy(t => t.StartsAt));

        // Разделы списка идут последовательно: сначала текущие, затем ближайшие будущие,
        // затем завершённые (свежие сверху).
        _running.AddRange(_tournaments.Where(t => t.Status == TournamentStatus.Running).OrderBy(t => t.StartsAt));
        _next.AddRange(_tournaments.Where(t => t.Status == TournamentStatus.Created).OrderBy(t => t.StartsAt));
        _finished.AddRange(_tournaments.Where(t => t.Status == TournamentStatus.Finished).OrderByDescending(t => t.StartsAt));
    }

    private void BuildTimeline(DateTimeOffset windowStart)
    {
        int cols = Hours * 2;
        foreach (var t in _tournaments!)
        {
            var type = TypeOf(t.TimeControl);
            int startHalf = (int)Math.Round((t.StartsAt.ToLocalTime() - windowStart).TotalMinutes / 30.0);
            if (startHalf < 0 || startHalf >= cols) continue;
            int span = Math.Max(1, (int)Math.Round(t.DurationSeconds / 1800.0));
            span = Math.Min(span, cols - startHalf);

            _blocks.Add(new Block(
                Id: t.Id, Col: startHalf + 2, Span: span, Row: LaneRow(type) + _laneOffset, Type: type,
                Title: ShortName(type), Time: t.StartsAt.ToLocalTime().ToString("HH:mm"),
                Humans: t.HumanCount, Bots: t.BotCount, Tc: t.TimeControl.ToString(), State: StateOf(t.Status),
                Mine: t.Joined));
        }
    }

    // Бренд-турниры, попадающие в окно таймлайна — отдельной верхней дорожкой (row 2); регулярные
    // лейны сдвигаются вниз на _laneOffset. Счётчики/статус — из живой сводки грейна.
    private void BuildBrandBlocks(DateTimeOffset windowStart)
    {
        int cols = Hours * 2;
        foreach (var v in _brand)
        {
            var b = v.Brand;
            int startHalf = (int)Math.Round((b.StartsAt.ToLocalTime() - windowStart).TotalMinutes / 30.0);
            if (startHalf < 0 || startHalf >= cols) continue;
            int span = Math.Min(Math.Max(1, (int)Math.Round(b.DurationSeconds / 1800.0)), cols - startHalf);
            _brandBlocks.Add(new Block(
                Id: b.Slug, Col: startHalf + 2, Span: span, Row: 2, Type: "brand", Title: b.Name,
                Time: b.StartsAt.ToLocalTime().ToString("HH:mm"), Humans: v.Summary.HumanCount, Bots: v.Summary.BotCount,
                Tc: new TimeControl(b.InitialSeconds, b.IncrementSeconds).ToString(), State: StateOf(v.Summary.Status),
                Mine: v.Summary.Joined));
        }
        _laneOffset = _brandBlocks.Count > 0 ? 1 : 0;
    }

    // Статус-плашка карточки в ленте «Главных»: идёт сейчас / завтра / через N дн / скоро / завершён.
    private (string Cls, string Label) BrandPill(BrandTournamentView v)
    {
        if (v.Summary.Status == TournamentStatus.Running) return ("live", Loc.StatusLabel("live", 0));
        if (v.Summary.Status == TournamentStatus.Finished) return ("done", Loc.StatusLabel("done", 0));
        var today = DateOnly.FromDateTime(DateTime.Now);
        var start = DateOnly.FromDateTime(v.Brand.StartsAt.ToLocalTime().DateTime);
        var days = Math.Max(0, start.DayNumber - today.DayNumber);
        var kind = days <= 1 ? "tomorrow" : days <= 14 ? "soon" : "later";
        return (days <= 14 ? "soon" : "later", Loc.StatusLabel(kind, days));
    }

    private static string BlockTitle(Block b) => (b.Mine ? Loc.T("mine.title") + " · " : "") + StateHint(b.State);

    private static int LaneRow(string type) => type switch { "bullet" => 2, "blitz" => 3, _ => 4 };

    private static string StateOf(TournamentStatus s) => s switch
    {
        TournamentStatus.Running => "live",
        TournamentStatus.Finished => "past",
        _ => "future"
    };

    private static string StateHint(string state) => state switch
    {
        "live" => Loc.T("hint.live"),
        "past" => Loc.T("hint.past"),
        _ => Loc.T("hint.future")
    };

    private static string TypeOf(TimeControl tc) => tc.InitialSeconds switch
    {
        <= 120 => "bullet",
        <= 480 => "blitz",
        _ => "rapid"
    };

    private static string ShortName(string type) => type switch
    {
        "bullet" => "Bullet",
        "rapid" => "Rapid",
        _ => "Blitz"
    };

    private static string Icon(string type) => type switch
    {
        "brand" => "★",
        "bullet" => "⚡",
        "rapid" => "⏱",
        _ => "🔥"
    };

    private static string StatusText(TournamentStatus s) => s switch
    {
        TournamentStatus.Running => Loc.T("status.live"),
        TournamentStatus.Finished => Loc.T("status.finished"),
        _ => Loc.T("status.reg")
    };

    private static string StatusBadge(TournamentStatus s) => s switch
    {
        TournamentStatus.Running => "badge-success",
        TournamentStatus.Finished => "",
        _ => "badge-warn"
    };
}

<style>
    .sched > .sv-state { display: none; }

    .sched-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .sched-status { display: flex; align-items: center; gap: .55rem; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-bottom: .35rem; }
    .sched-status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--danger); box-shadow: 0 0 0 3px var(--danger-weak); }
    .sched h1 { margin: 0; }

    .sched-controls { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
    .sched-filters { display: flex; align-items: center; gap: 10px; }

    .seg { display: inline-flex; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 3px; gap: 2px; }
    .seg label, .seg .rng { display: inline-flex; align-items: center; gap: .4rem; padding: .42rem .85rem; border-radius: var(--r-pill); font-size: .85rem; font-weight: 600; color: var(--ink-2); cursor: pointer; user-select: none; white-space: nowrap; border: 0; background: transparent; }
    .seg label svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; }
    .seg .rng.is-active { background: var(--ink); color: #fff; }

    .now-pill { display: inline-flex; align-items: center; gap: .2rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 2px; }
    .now-pill .chev { border: 0; background: transparent; color: var(--muted); font-size: 1.1rem; line-height: 1; padding: .25rem .5rem; cursor: pointer; border-radius: var(--r-pill); }
    .now-pill .chev:hover { background: var(--surface-2); color: var(--ink); }
    .now-pill .now-btn { border: 0; background: transparent; color: var(--ink-2); font-weight: 600; font-size: .85rem; padding: .25rem .4rem; cursor: pointer; }
    .now-pill .now-btn:hover { color: var(--ink); }

    #sv-tl:checked ~ .sched-top .seg-view label[for="sv-tl"],
    #sv-list:checked ~ .sched-top .seg-view label[for="sv-list"] { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-sm); }

    .view-list { display: none; }
    #sv-list:checked ~ .view-list { display: block; }
    #sv-list:checked ~ .view-tl { display: none; }

    /* ---------------- Лента «Главные турниры» ---------------- */
    /* auto-fill (не auto-fit): пустые треки сохраняются, поэтому единственная карточка не растягивается на всю ширину. */
    .bt-rail { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 280px)); gap: 12px; margin-top: 18px; justify-content: start; }
