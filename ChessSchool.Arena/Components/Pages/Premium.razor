@page "/premium"
@using ChessSchool.Arena
@using ChessSchool.Arena.Services
@inject IHttpContextAccessor Http
@inject IConfiguration Config
@inject IPlayerEntitlements Entitlements
@inject NavigationManager Nav

@* Премиум-подписка игрока: статический SSR-каркас. Оплата — hosted Checkout Paddle (Paddle.js v2),
   карты у нас не ходят. Премиум-статус — из ApiService (источник истины). premium.js (глобально в
   App.razor) навешивает обработчик кнопки (Paddle или dev-активация), переживает enhanced-навигацию. *@

<PageTitle>@Loc.T("premium.title") — ChessArena</PageTitle>
<HeadContent>
    <meta name="description" content="@Loc.T("premium.lead")" />
    <link rel="canonical" href="@($"{Nav.BaseUri}premium")" />
</HeadContent>

<h1 class="prem-h1">@Loc.T("premium.title")</h1>
<p class="text-secondary prem-lead">@Loc.T("premium.lead")</p>

@if (!_authed)
{
    <div class="card prem-card">
        <p class="text-secondary">@Loc.T("premium.login")</p>
        <a class="btn btn-primary" href="/signin?returnUrl=/premium" data-enhance-nav="false">@Loc.T("premium.loginbtn")</a>
    </div>
}
else if (_isPremium)
{
    <div class="card prem-card">
        <p class="prem-have">@Loc.T("premium.have")</p>
        <div class="prem-actions">
            @* Внешний редирект на Customer Portal Paddle: отключаем enhanced-nav, иначе Blazor делает fetch
               и не может последовать за 302 на чужой домен (CORS) — ссылка «зависает». *@
            <a class="btn btn-sm btn-outline" href="/premium/portal" data-enhance-nav="false">@Loc.T("premium.manage")</a>
            @* Подтянуть статус из API (на случай отмены/изменения в портале) — premium.js навешивает обработчик. *@
            <button id="prem-refresh" class="btn btn-sm btn-outline">@Loc.T("premium.refresh")</button>
        </div>
    </div>
}
else if (!_emailVerified)
{
    @* Мягкий гейт: премиум — чувствительное действие (оплата/письма-чеки), только после подтверждения e-mail. *@
    <div class="card prem-card">
        <ul class="prem-perks"><li>@Loc.T("premium.perk")</li></ul>
        <p class="text-secondary">@Loc.T("verify.premium")</p>
        <a class="btn btn-primary" href="@_manageEmailUrl" data-enhance-nav="false">@Loc.T("verify.premium.cta")</a>
    </div>
}
else
{
    <div class="card prem-card">
        <ul class="prem-perks"><li>@Loc.T("premium.perk")</li></ul>

        @* Пробный период: показываем, если задан Paddle:TrialDays. Сам триал настраивается на цене в Paddle
           (карта привязывается, списание — после периода), статус trialing уже даёт премиум. *@
        @if (_paddle && _trialDays > 0)
        {
            <p id="prem-trial" class="prem-trial">@string.Format(Loc.T("premium.trial.note"), _trialDays)</p>
        }

        @* Выбор плана (месяц/год) — только в режиме Paddle и если задан годовой price_id. Годовой выбран
           по умолчанию: меньше «точек продления» = меньше оттока. Чекаут идёт по выбранному плану. *@
        @if (_paddle && _hasAnnual)
        {
            <div class="prem-plans" role="radiogroup" aria-label="@Loc.T("premium.plan.choose")">
                <button type="button" class="prem-plan" data-price="@_priceId" data-period="month">
                    <span class="pp-name">@Loc.T("premium.plan.month")</span>
                    <span class="pp-amt" data-amt></span>
                </button>
                <button type="button" class="prem-plan is-sel" data-price="@_priceAnnual" data-period="year">
                    @* Бейдж выгоды: начальный текст из конфига (необязателен); premium.js заменит на
                       вычисленный «−N%» из реальных цен PricePreview. Скрыт, пока нечего показать. *@
                    <span class="pp-badge" data-save hidden>@_annualNote</span>
                    <span class="pp-name">@Loc.T("premium.plan.year")</span>
                    <span class="pp-amt" data-amt></span>
                </button>
            </div>
        }

        <div class="prem-actions">
            <button id="prem-buy" class="btn btn-primary">@BuyLabel()</button>
            @if (_paddle)
            {
                <button id="prem-refresh" class="btn btn-sm btn-outline">@Loc.T("premium.refresh")</button>
            }
        </div>
        <p id="prem-status" class="prem-status" role="alert" hidden></p>
    </div>
    @* Параметры для premium.js: режим (paddle/dev), client-токен/price (месяц)/годовой price/окружение, user_sub. *@
    <div id="prem-root" hidden
         data-mode="@(_paddle ? "paddle" : "dev")"
         data-token="@_token" data-price="@_priceId" data-price-annual="@_priceAnnual" data-env="@_env"
         data-sub="@_sub" data-success="@($"{Nav.BaseUri}premium")"
         data-trial-days="@_trialDays" data-trial-note="@Loc.T("premium.trial.note")"
         data-trial-cta="@Loc.T("premium.trial.cta")" data-buy-label="@Loc.T("premium.buy")"></div>
}

@code {
    private bool _authed, _isPremium, _paddle, _hasAnnual, _emailVerified;
    private int _trialDays;
    private string _sub = "", _token = "", _priceId = "", _priceAnnual = "", _annualNote = "", _env = "sandbox";
    private string _manageEmailUrl = "/";

    // Подпись кнопки: с пробным периодом — «Попробовать N дней бесплатно», иначе обычная покупка/dev.
    private string BuyLabel() => !_paddle
        ? Loc.T("premium.dev")
        : _trialDays > 0 ? string.Format(Loc.T("premium.trial.cta"), _trialDays) : Loc.T("premium.buy");

    protected override async Task OnInitializedAsync()
    {
        var user = Http.HttpContext?.User;
        _authed = user?.Identity?.IsAuthenticated == true;
        _emailVerified = user.IsEmailVerified();
        // Ссылка на управление e-mail в IdP (подтвердить/сменить), с возвратом на /premium. Через единый
        // хелпер Config.IdpUrl (хост из ResolveSsoAuthority) — НЕ из сырого Config["Sso:Authority"] (локально пуст).
        _manageEmailUrl = Config.IdpUrl("/account/email", $"{Nav.BaseUri}premium");
        _sub = user?.FindFirst("sub")?.Value ?? "";
        _token = Config["Paddle:ClientToken"] ?? "";
        _priceId = Config["Paddle:PremiumPriceId"] ?? "";
        _priceAnnual = Config["Paddle:PremiumPriceIdAnnual"] ?? ""; // годовой план (необязателен)
        _annualNote = Config["Paddle:AnnualNote"] ?? "";            // бейдж выгоды, напр. «−17%» / «2 мес. в подарок»
        _trialDays = int.TryParse(Config["Paddle:TrialDays"], out var td) && td > 0 ? td : 0; // длина триала для текста
        _env = Config["Paddle:Environment"] ?? "sandbox";
        _paddle = !string.IsNullOrWhiteSpace(_token) && !string.IsNullOrWhiteSpace(_priceId);
        _hasAnnual = !string.IsNullOrWhiteSpace(_priceAnnual);
        if (_authed) _isPremium = await Entitlements.IsPremiumAsync(_sub);
    }
}

<style>
    .prem-h1 { font-size: 1.8rem; margin: 0 0 .4rem; }
    .prem-lead { margin: 0 0 1.4rem; }
    .prem-card { max-width: 460px; }
    .prem-have { font-weight: 700; color: var(--success); margin: 0; }
    .prem-perks { margin: 0 0 1rem; padding-left: 1.1rem; color: var(--ink-2); }
    .prem-trial { margin: 0 0 1rem; padding: .55rem .7rem; font-size: .9rem; font-weight: 600; color: #0a7d33;
        background: #d7f5e0; border: 1px solid #9fe3b6; border-radius: var(--r-md); }
    .prem-perks li { margin: .2rem 0; }
    .prem-actions { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
    .prem-status { margin: .8rem 0 0; font-size: .88rem; color: var(--danger, #c0392b); }

    /* Выбор плана: месяц/год; выбранный — акцентная рамка, годовой по умолчанию */
    .prem-plans { display: flex; gap: .6rem; margin: 0 0 1rem; }
    .prem-plan { position: relative; flex: 1; text-align: left; cursor: pointer; padding: .7rem .8rem;
        border: 2px solid var(--line); border-radius: var(--r-md); background: var(--surface); color: var(--ink); }
    .prem-plan:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
    .prem-plan.is-sel { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 7%, var(--surface)); }
    .pp-name { display: block; font-weight: 700; }
    .pp-amt { display: block; color: var(--ink-2); font-size: .9rem; font-variant-numeric: tabular-nums; min-height: 1.1em; }
    .pp-badge { position: absolute; top: -9px; right: 8px; font-size: .66rem; font-weight: 800; letter-spacing: .02em;
        text-transform: uppercase; color: #6e5200; background: #fff3cf; border: 1px solid #e0ad00; border-radius: var(--r-pill); padding: .05rem .4rem; }
</style>
