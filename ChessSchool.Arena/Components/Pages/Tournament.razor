@page "/t/{Id}"
@rendermode InteractiveServer
@using ChessSchool.Arena.Services
@inject IGrainFactory Grains
@inject ArenaNotifier Notifier
@inject AuthenticationStateProvider AuthState
@implements IAsyncDisposable

<PageTitle>@(_state?.Name ?? "Турнир")</PageTitle>

@if (_state is null)
{
    <p class="text-muted"><em>Загрузка…</em></p>
}
else
{
    <nav class="crumbs">
        <a href="/">Главная</a><span>›</span>
        <a href="/">Турниры «Арена»</a><span>›</span>
        <span class="crumbs-cur">@_state.Name</span>
    </nav>

    <div class="t-grid">
        <div class="t-main">
            @* ----- Шапка турнира ----- *@
            <div class="t-hero card">
                <div class="t-thumb @(_state.Status == TournamentStatus.Running ? "" : "dim")">
                    @if (_state.Status == TournamentStatus.Running)
                    {
                        <span class="t-live"><span class="t-dot"></span>Live</span>
                    }
                    else if (_state.Status == TournamentStatus.Finished)
                    {
                        <span class="t-live past">Завершён</span>
                    }
                    else
                    {
                        <span class="t-live past">Скоро</span>
                    }
                </div>

                <div class="t-hero-mid">
                    <div class="t-meta">
                        <span>@_state.StartedAt.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</span><span class="sep">•</span>
                        <span>@(_state.DurationSeconds / 60) минут</span><span class="sep">•</span>
                        <span>Контроль @(_state.TimeControl.InitialSeconds / 60) + @_state.TimeControl.IncrementSeconds</span>
                    </div>
                    <h1 class="t-title">@_state.Name</h1>
                </div>

                <div class="t-hero-side">
                    @if (_state.Status == TournamentStatus.Running)
                    {
                        <div class="t-countdown">Окончание через: <strong>@Hms(Remaining())</strong></div>
                    }
                    else if (_state.Status == TournamentStatus.Created)
                    {
                        <div class="t-countdown">Старт: <strong>@_state.StartedAt.ToLocalTime().ToString("dd.MM, HH:mm")</strong></div>
                    }

                    <div class="t-parts" title="@HumanCount чел. · @_state.BotCount ботов">
                        <span class="t-ava-row">
                            @foreach (var s in _state.Standings.Take(3))
                            {
                                <span class="t-ava">@Avatar(s.Name)</span>
                            }
                        </span>
                        <span>@_state.Standings.Count @Plural(_state.Standings.Count, "участник", "участника", "участников")</span>
                    </div>

                    @ActionButton()
                </div>
            </div>

            @* ----- Своя интерактивная партия (когда участвуешь и идёт турнир) ----- *@
            @if (_state.Status == TournamentStatus.Running && _state.Joined)
            {
                @if (_state.MyGame is { } g)
                {
                    <div class="card my-game">
                        <div class="players">
                            <span>@(g.BlackBerserk ? "⚡ " : "")@g.BlackName <span class="clock @(g.Turn == PieceColor.Black && g.Status == GameStatus.InProgress ? "active" : "")">@Mmss(EffMs(g, false) / 1000)</span></span>
                            <span>@(g.WhiteBerserk ? "⚡ " : "")@g.WhiteName <span class="clock @(g.Turn == PieceColor.White && g.Status == GameStatus.InProgress ? "active" : "")">@Mmss(EffMs(g, true) / 1000)</span></span>
                        </div>
                        <Chessboard Fen="@g.Fen" FlipForBlack="g.MyColor == PieceColor.Black"
                                    LastFrom="@g.LastFrom" LastTo="@g.LastTo" CheckSquare="@g.CheckSquare"
                                    Disabled="@(g.Status != GameStatus.InProgress)"
                                    MyTurn="@(g.Turn == g.MyColor)" OnMove="DoMove" />
                        <div class="gstatus">
                            @if (g.Status == GameStatus.Finished)
                            {
                                <strong>@ResultText(g)</strong> <span class="text-muted">— ждём следующего соперника…</span>
                            }
                            else
                            {
                                <span class="text-secondary">@(g.Turn == g.MyColor ? "Ваш ход" : "Ход соперника — можно сделать предход")</span>
                                <span class="ds-spacer"></span>
                                @if (g.MyBerserkAvailable)
                                {
                                    <button class="btn btn-warn btn-sm" @onclick="Berserk" title="Время пополам, без инкремента, +1 очко за победу">⚡ Berserk</button>
                                }
                                <button class="btn btn-outline-danger btn-sm" @onclick="Resign">Сдаться</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="card waiting">
                        <div class="search-anim" aria-hidden="true">
                            <span class="search-ring"></span>
                            <span class="search-piece">@((MarkupString)ChessPieces.Svg('n'))</span>
                        </div>
                        <div class="search-text">Ищем соперника<span class="dots"><i></i><i></i><i></i></span></div>
                        <div class="text-muted mt-1">Ваши очки: <strong>@_state.MyScore</strong></div>
                    </div>
                }
            }

            @* ----- Трансляция партий (4 доски + «Все игры») ----- *@
            @if (Broadcast().Count > 0)
            {
                <div class="sec-head">
                    <h2 class="sec-title">Партии</h2>
                    <a class="all-games" href="/t/@Id/games">Все игры</a>
                </div>
                <div class="boards-grid">
                    @foreach (var b in Broadcast().Take(4))
                    {
                        <div class="bcard @(b.Status == GameStatus.Finished ? "done" : "")">
                            <div class="bplayer">
                                <span class="bava">@Avatar(b.BlackName)</span>
                                <span class="bname">@b.BlackName</span>
                                <span class="bscore">@b.BlackScore</span>
                            </div>
                            <div class="bclock @(b.Turn == PieceColor.Black && b.Status == GameStatus.InProgress ? "active" : "")">@Mmss(b.BlackMs / 1000)</div>
                            <div class="bboard">
                                <Chessboard Fen="@b.Fen" LastFrom="@b.LastFrom" LastTo="@b.LastTo" CheckSquare="@b.CheckSquare" Disabled="true" />
                                @if (b.Status == GameStatus.Finished)
                                {
                                    <div class="bresult">
                                        <span class="rcell w">@GResult(b.Result, true)</span>
                                        <span class="rdash">–</span>
                                        <span class="rcell b">@GResult(b.Result, false)</span>
                                    </div>
                                }
                            </div>
                            <div class="bclock @(b.Turn == PieceColor.White && b.Status == GameStatus.InProgress ? "active" : "")">@Mmss(b.WhiteMs / 1000)</div>
                            <div class="bplayer">
                                <span class="bava">@Avatar(b.WhiteName)</span>
                                <span class="bname">@b.WhiteName</span>
                                <span class="bscore">@b.WhiteScore</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @* ----- Таблица лидеров ----- *@
            @{
                var ranked = _state.Standings;
                var podium = ranked.Take(3).ToList();
            }
            @if (podium.Count > 0)
            {
                <div class="podium">
                    @foreach (var p in podium)
                    {
                        <div class="pod @PodClass(p.Rank)">
                            <div class="pod-cup">@Trophy(p.Rank)</div>
                            <div class="pod-name">@p.Name</div>
                            <div class="pod-stat">@p.Games игр • @p.Wins побед • @p.Score очков</div>
                        </div>
                    }
                </div>
            }
            <div class="st-list">
                @foreach (var s in ranked)
                {
                    <div class="st-card">
                        <div class="st-head">
                            <span class="st-ava">@Avatar(s.Name)</span>
                            <span class="st-name">@s.Name @if (s.OnFire) { <span class="fire">🔥 @s.Streak</span> }</span>
                            <span class="st-place">@(s.Rank) Место</span>
                            <span class="st-score">@s.Score</span>
                        </div>
                        @if (s.Results.Count > 0)
                        {
                            <div class="st-chips">
                                @foreach (var r in s.Results)
                                {
                                    <span class="chip @ChipClass(r)">@r</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ----- Правая колонка: правила (на мобиле уезжает вниз страницы) ----- *@
        <aside class="t-side">
            <div class="card score-rules">
                <h3 class="card-title">Порядок начисления очков</h3>
                <div class="sr-sub">Результаты партий</div>
                <div class="sr-row"><span>Победа</span><strong>+ 2</strong></div>
                <div class="sr-row"><span>Ничья</span><strong>+ 1</strong></div>
                <div class="sr-row"><span>Поражение</span><strong>0</strong></div>
                <div class="sr-bonus"><span>🔥 2 победы подряд</span><strong>Бонус ×2</strong></div>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private bool _authenticated;
    private string _sub = "", _name = "Игрок";
    private ArenaStateDto? _state;
    private DateTimeOffset _stateAt;
    private PeriodicTimer? _clock;
    private IDisposable? _subscription;

    private IArenaTournamentGrain T => Grains.GetGrain<IArenaTournamentGrain>(Id);

    private int HumanCount => _state is null ? 0 : Math.Max(0, _state.Standings.Count - _state.BotCount);

    // Партии для трансляции, исключая собственную (она показана отдельной интерактивной доской).
    private List<ArenaBoardDto> Broadcast() => _state is null
        ? []
        : _state.Boards.Where(b => _state.MyGame is null || b.GameId != _state.MyGame.GameId).ToList();

    // Осталось до конца турнира (с локальной анимацией между обновлениями состояния).
    private int Remaining() => _state is null ? 0
        : Math.Max(0, _state.SecondsLeft - (int)(DateTimeOffset.UtcNow - _stateAt).TotalSeconds);

    private RenderFragment ActionButton() => builder =>
    {
        // Кнопка действия в шапке: вход / запись / участие — в зависимости от статуса и авторизации.
        string? label = null, css = "btn btn-join", badge = null;
        Action? onClick = null;

        if (!_authenticated && _state!.Status != TournamentStatus.Finished)
        {
            label = _state.Status == TournamentStatus.Created ? "Войти и записаться" : "Войти";
        }
        else if (_state!.Status == TournamentStatus.Running && _authenticated)
        {
            if (_state.Joined) badge = "Вы в турнире ✓";
            else { label = "Присоединиться"; onClick = () => _ = Join(); }
        }
        else if (_state.Status == TournamentStatus.Created && _authenticated)
        {
            if (_state.Joined) badge = "Вы записаны ✓";
            else { label = "Записаться"; onClick = () => _ = Join(); }
        }

        if (badge is not null)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge badge-success t-badge");
            builder.AddContent(2, badge);
            builder.CloseElement();
        }
        else if (label is not null && onClick is not null)
        {
            builder.OpenElement(10, "button");
            builder.AddAttribute(11, "class", css);
            builder.AddAttribute(12, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, onClick));
            builder.AddContent(13, label);
            builder.CloseElement();
        }
        else if (label is not null)
        {
            builder.OpenElement(20, "a");
            builder.AddAttribute(21, "class", css);
            builder.AddAttribute(22, "href", $"/signin?returnUrl=/t/{Id}");
            builder.AddContent(23, label);
            builder.CloseElement();
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _authenticated = user.Identity?.IsAuthenticated == true;
        if (_authenticated)
        {
            _sub = user.FindFirst("sub")?.Value ?? user.Identity!.Name ?? "anon";
            _name = user.Identity!.Name ?? "Игрок";
        }

        await Refresh(); // состояние доступно и анонимам (просмотр результатов)

        _subscription = Notifier.Subscribe(Id, () => _ = OnNotifiedAsync());
        _ = AnimateClockAsync();
    }

    private async Task OnNotifiedAsync()
    {
        await Refresh();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Refresh()
    {
        _state = await T.GetStateAsync(_sub);
        _stateAt = DateTimeOffset.UtcNow;
    }

    private async Task AnimateClockAsync()
    {
        _clock = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        while (await _clock.WaitForNextTickAsync())
            if (_state is { Status: TournamentStatus.Running }) // тикают часы партий и обратный отсчёт
                await InvokeAsync(StateHasChanged);
    }

    private async Task Join() { await T.JoinAsync(_sub, _name); await Refresh(); await InvokeAsync(StateHasChanged); }

    private async Task DoMove((string From, string To, string? Promotion) m)
    {
        await T.MoveAsync(_sub, new MoveInput(m.From, m.To, m.Promotion));
        await Refresh();
    }

    private async Task Berserk() { await T.BerserkAsync(_sub); await Refresh(); }

    private async Task Resign() { await T.ResignAsync(_sub); await Refresh(); }

    private long EffMs(ArenaGameDto g, bool white)
    {
        long baseMs = white ? g.WhiteMs : g.BlackMs;
        bool active = g.Status == GameStatus.InProgress &&
            ((white && g.Turn == PieceColor.White) || (!white && g.Turn == PieceColor.Black));
        if (!active) return baseMs;
        return Math.Max(0, baseMs - (long)(DateTimeOffset.UtcNow - _stateAt).TotalMilliseconds);
    }

    private static string Mmss(long seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return $"{(int)t.TotalMinutes:D2}:{t.Seconds:D2}";
    }

    private static string Hms(int seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return $"{(int)t.TotalHours:D2}:{t.Minutes:D2}:{t.Seconds:D2}";
    }

    private static string Trophy(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => rank.ToString() };
    private static string PodClass(int rank) => rank switch { 1 => "gold", 2 => "silver", 3 => "bronze", _ => "" };

    private static string ChipClass(int r) => r switch { >= 4 => "c-bonus", 2 => "c-win", 1 => "c-draw", _ => "c-loss" };

    private static readonly string[] Avatars = ["👶", "🧑", "🧔", "🧓", "👩", "🧒", "👨", "👧"];
    private static string Avatar(string name)
    {
        int h = 0;
        foreach (var ch in name) h = (h * 31 + ch) & 0x7fffffff;
        return Avatars[h % Avatars.Length];
    }

    private static string Plural(int n, string one, string few, string many)
    {
        int m10 = n % 10, m100 = n % 100;
        if (m10 == 1 && m100 != 11) return one;
        if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
        return many;
    }

    private static string GResult(GameResult r, bool white) => r switch
    {
        GameResult.Draw => "½",
        GameResult.WhiteWins => white ? "1" : "0",
        GameResult.BlackWins => white ? "0" : "1",
        _ => "—"
    };

    private static string ResultText(ArenaGameDto g) => g.Result switch
    {
        GameResult.WhiteWins => "Победили белые",
        GameResult.BlackWins => "Победили чёрные",
        GameResult.Draw => "Ничья",
        _ => "—"
    };

    public ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        _clock?.Dispose();
        return ValueTask.CompletedTask;
    }
}

<style>
    .crumbs { display: flex; align-items: center; gap: .5rem; font-size: .92rem; color: var(--ink-2); margin-bottom: 1rem; flex-wrap: wrap; }
    .crumbs a { color: var(--ink-2); font-weight: 600; }
    .crumbs a:hover { color: var(--accent); }
    .crumbs span { color: var(--muted); }
    .crumbs .crumbs-cur { color: var(--ink); font-weight: 600; }

    /* ----- Сетка страницы: контент + правая колонка с правилами ----- */
    .t-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1.4rem; align-items: start; }
    .t-main { min-width: 0; }
    .t-side { position: sticky; top: 1rem; }

    /* ----- Шапка турнира ----- */
    .t-hero { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
    .t-thumb { flex: none; width: 220px; aspect-ratio: 16 / 10; border-radius: var(--r-md); position: relative; overflow: hidden;
        background-color: #1a1714; background-image: repeating-conic-gradient(#3b352e 0 25%, #2a2622 0 50%); background-size: 44px 44px; }
    .t-thumb::after { content: ""; position: absolute; inset: 0; background: radial-gradient(120% 90% at 72% 18%, transparent, rgba(0,0,0,.6)); }
    .t-thumb.dim { filter: grayscale(.5) brightness(.85); }
    .t-live { position: absolute; z-index: 1; top: 10px; left: 10px; display: inline-flex; align-items: center; gap: .35rem; background: #e23b3b; color: #fff; font-weight: 700; font-size: .75rem; padding: .25rem .6rem; border-radius: var(--r-pill); }
    .t-live.past { background: rgba(20, 22, 26, .72); }
    .t-dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0 rgba(255,255,255,.7); animation: tpulse 1.4s infinite; }
    @@keyframes tpulse { 0% { box-shadow: 0 0 0 0 rgba(255,255,255,.6); } 70% { box-shadow: 0 0 0 6px rgba(255,255,255,0); } 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } }

    .t-hero-mid { flex: 1 1 220px; min-width: 0; }
    .t-meta { display: flex; flex-wrap: wrap; gap: .4rem .6rem; align-items: center; color: var(--ink-2); font-size: .95rem; }
    .t-meta .sep { color: var(--muted); }
    .t-title { margin: .3rem 0 0; font-size: 1.5rem; }

    .t-hero-side { display: flex; flex-direction: column; align-items: flex-end; gap: .6rem; }
    .t-countdown { color: var(--ink-2); font-size: .95rem; }
    .t-countdown strong { font-variant-numeric: tabular-nums; color: var(--ink); font-size: 1.05rem; }
    .t-parts { display: inline-flex; align-items: center; gap: .6rem; background: var(--surface-2); border-radius: var(--r-pill); padding: .4rem .9rem; color: var(--ink-2); font-weight: 600; }
    .t-ava-row { display: inline-flex; }
    .t-ava { width: 28px; height: 28px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; font-size: 1rem; border: 2px solid var(--surface); margin-left: -10px; box-shadow: var(--shadow-sm); }
    .t-ava-row .t-ava:first-child { margin-left: 0; }
    .t-badge { font-size: .9rem; }

    .btn-join { background: #21b85a; color: #fff; font-weight: 700; border: none; padding: .7rem 1.6rem; border-radius: var(--r-md); cursor: pointer; }
    .btn-join:hover { background: #1ca350; }

    /* ----- Заголовок секции «Партии» + «Все игры» ----- */
    .sec-head { display: flex; align-items: baseline; justify-content: space-between; margin: 1.8rem 0 1rem; }
    .sec-title { font-size: 1.5rem; margin: 0; }
    .all-games { color: var(--accent); font-weight: 700; }
    .all-games:hover { text-decoration: underline; }

    /* ----- Трансляция партий ----- */
    .boards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.2rem; }
    .bcard { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 12px; box-shadow: var(--shadow-sm); }
    .bcard.done { opacity: .9; }
    .bplayer { display: flex; align-items: center; gap: .5rem; padding: .15rem 0; }
    .bava { width: 26px; height: 26px; border-radius: 50%; background: var(--surface-2); display: grid; place-items: center; font-size: .95rem; flex: none; }
    .bname { font-weight: 650; font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bscore { margin-left: auto; font-weight: 800; font-variant-numeric: tabular-nums; }
    .bclock { align-self: flex-end; font-variant-numeric: tabular-nums; font-size: .82rem; font-weight: 600; color: var(--ink-2); background: var(--surface-2); border-radius: var(--r-sm); padding: .05rem .45rem; margin: .15rem 0; display: inline-block; }
    .bclock.active { background: var(--ink); color: #fff; }
    .bboard { position: relative; margin: .35rem 0; }
    .bboard .board-wrap { width: 100%; }
    .bresult { position: absolute; inset: 0; margin: auto; width: max-content; height: max-content; display: flex; align-items: center; gap: .15rem; }
    .bresult .rcell { width: 48px; height: 60px; display: grid; place-items: center; font-size: 2rem; font-weight: 800; box-shadow: var(--shadow-md); }
    .bresult .rcell.w { background: #fff; color: #111; }
    .bresult .rcell.b { background: #111; color: #fff; }
    .bresult .rdash { color: #fff; font-weight: 800; text-shadow: 0 1px 4px rgba(0,0,0,.6); }

    /* ----- Своя партия ----- */
    .my-game { margin-top: 1.2rem; }
    .my-game .players { display: flex; flex-direction: column; gap: .35rem; margin-bottom: .75rem; font-size: 1.05rem; }
    .clock { font-variant-numeric: tabular-nums; padding: .1rem .5rem; border-radius: var(--r-sm); background: var(--surface-2); color: var(--ink); font-weight: 600; margin-left: .4rem; }
    .clock.active { background: var(--accent); color: #fff; }
    .gstatus { margin-top: .85rem; display: flex; gap: .6rem; align-items: center; }
    .waiting { text-align: center; padding: 2.5rem 1rem; font-size: 1.05rem; color: var(--ink-2); margin-top: 1.2rem; }
    .search-anim { position: relative; width: 76px; height: 76px; margin: 0 auto .9rem; display: grid; place-items: center; }
    .search-ring { position: absolute; inset: 0; border-radius: 50%; border: 3px solid var(--accent); border-top-color: transparent; animation: search-spin 1s linear infinite; }
    .search-ring::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); animation: search-pulse 1.6s ease-out infinite; }
    .search-piece { width: 42px; height: 42px; display: block; animation: search-bob 1.6s ease-in-out infinite; }
    .search-piece .cp { width: 100%; height: 100%; display: block; }
    .search-text { font-weight: 600; color: var(--ink); }
    .search-text .dots { display: inline-block; letter-spacing: .05em; }
    .search-text .dots i { display: inline-block; opacity: .2; animation: search-dot 1.4s infinite; }
    .search-text .dots i::before { content: "."; }
    .search-text .dots i:nth-child(2) { animation-delay: .2s; }
    .search-text .dots i:nth-child(3) { animation-delay: .4s; }
    @@keyframes search-spin { to { transform: rotate(360deg); } }
    @@keyframes search-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); } 100% { box-shadow: 0 0 0 18px transparent; } }
    @@keyframes search-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
