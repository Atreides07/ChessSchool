@page "/t/{Id}"
@using ChessSchool.Arena
@inject IHttpContextAccessor Http

@* Страница турнира на «тонком» клиенте: статический SSR-каркас без серверной Blazor-цепи и без
   ре-рендеров по таймеру. Шапку/таблицу/доски/свою партию рендерит браузерный JS (tournament.js),
   синхронизация — SignalR прямо к /arenahub (cookie-auth, тот же origin), часы анимируются локально.
   Это снимает «состояние на зрителя» с веб-сервера (масштаб) и переживает плохую сеть (reconnect → ресинк). *@

<PageTitle>@Loc.T("t.fallback") — ChessArena</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

@{
    var authed = Http.HttpContext?.User?.Identity?.IsAuthenticated == true;
}

<nav class="crumbs">
    <a href="/">@Loc.T("crumb.home")</a><span>›</span>
    <a href="/">@Loc.T("nav.arena")</a><span>›</span>
    <span class="crumbs-cur" id="t-crumb"></span>
</nav>

<div class="t-grid">
    <div class="t-main" id="t-main"><p class="text-muted"><em>@Loc.T("loading")</em></p></div>

    <aside class="t-side">
        <div class="card score-rules">
            <h3 class="card-title">@Loc.T("rules.title")</h3>
            <div class="sr-sub">@Loc.T("rules.sub")</div>
            <div class="sr-row"><span>@Loc.T("rules.win")</span><strong>+ 2</strong></div>
            <div class="sr-row"><span>@Loc.T("rules.draw")</span><strong>+ 1</strong></div>
            <div class="sr-row"><span>@Loc.T("rules.loss")</span><strong>0</strong></div>
            <div class="sr-bonus"><span>@Loc.T("rules.streak")</span><strong>@Loc.T("rules.bonus")</strong></div>
        </div>
    </aside>
</div>

<div id="t-root" data-id="@Id" data-authed="@(authed ? "1" : "0")" data-loginurl="/signin?returnUrl=/t/@Id"></div>
<script id="t-loc" type="application/json">@((MarkupString)LocJson())</script>
<script src="js/tournament.js"></script>

@code {
    [Parameter] public string Id { get; set; } = "";

    // Локализованные строки + формы множественного числа для клиентского JS (на язык запроса).
    private static string LocJson()
    {
        var l = new Dictionary<string, string>
        {
            ["loading"] = Loc.T("loading"),
            ["finished"] = Loc.T("t.finished"),
            ["soon"] = Loc.T("t.soon"),
            ["minutes"] = Loc.T("t.minutes"),
            ["control"] = Loc.T("t.control"),
            ["endin"] = Loc.T("t.endin"),
            ["start"] = Loc.T("t.start"),
            ["loginreg"] = Loc.T("act.loginreg"),
            ["login"] = Loc.T("act.login"),
            ["join"] = Loc.T("act.join"),
            ["injoined"] = Loc.T("act.injoined"),
            ["register"] = Loc.T("act.register"),
            ["registered"] = Loc.T("act.registered"),
            ["search"] = Loc.T("waiting.search"),
            ["score"] = Loc.T("waiting.score"),
            ["yourmove"] = Loc.T("game.yourmove"),
            ["oppmove"] = Loc.T("game.oppmove"),
            ["waitnext"] = Loc.T("game.waitnext"),
            ["berserktip"] = Loc.T("game.berserktip"),
            ["resign"] = Loc.T("game.resign"),
            ["games"] = Loc.T("sec.games"),
            ["allgames"] = Loc.T("link.allgames"),
            ["reswhite"] = Loc.T("res.white"),
            ["resblack"] = Loc.T("res.black"),
            ["resdraw"] = Loc.T("res.draw"),
            ["place"] = Loc.T("st.place"),
            ["podgames"] = Loc.T("pod.games"),
            ["podwins"] = Loc.T("pod.wins"),
            ["podpts"] = Loc.T("pod.pts"),
            // Формы множественного числа «участник(а/ов)» — переиспользуем серверную логику Loc.Participants.
            ["participant_one"] = Loc.Participants(1),
            ["participant_few"] = Loc.Participants(2),
            ["participant_many"] = Loc.Participants(5),
        };
        return System.Text.Json.JsonSerializer.Serialize(new { l, isEn = Loc.IsEn },
            new System.Text.Json.JsonSerializerOptions
            {
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
    }
}

<style>
    .crumbs { display: flex; align-items: center; gap: .5rem; font-size: .92rem; color: var(--ink-2); margin-bottom: 1rem; flex-wrap: wrap; }
    .crumbs a { color: var(--ink-2); font-weight: 600; }
    .crumbs a:hover { color: var(--accent); }
    .crumbs span { color: var(--muted); }
    .crumbs .crumbs-cur { color: var(--ink); font-weight: 600; }

    /* ----- Сетка страницы: контент + правая колонка с правилами ----- */
    .t-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1.4rem; align-items: start; }
    .t-main { min-width: 0; }
    .t-side { position: sticky; top: 1rem; }

    /* ----- Шапка турнира ----- */
    .t-hero { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
    .t-thumb { flex: none; width: 220px; aspect-ratio: 16 / 10; border-radius: var(--r-md); position: relative; overflow: hidden;
        background-color: #1a1714; background-image: repeating-conic-gradient(#3b352e 0 25%, #2a2622 0 50%); background-size: 44px 44px; }
    .t-thumb::after { content: ""; position: absolute; inset: 0; background: radial-gradient(120% 90% at 72% 18%, transparent, rgba(0,0,0,.6)); }
    .t-thumb.dim { filter: grayscale(.5) brightness(.85); }
    .t-live { position: absolute; z-index: 1; top: 10px; left: 10px; display: inline-flex; align-items: center; gap: .35rem; background: #e23b3b; color: #fff; font-weight: 700; font-size: .75rem; padding: .25rem .6rem; border-radius: var(--r-pill); }
    .t-live.past { background: rgba(20, 22, 26, .72); }
    .t-dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0 rgba(255,255,255,.7); animation: tpulse 1.4s infinite; }
    @@keyframes tpulse { 0% { box-shadow: 0 0 0 0 rgba(255,255,255,.6); } 70% { box-shadow: 0 0 0 6px rgba(255,255,255,0); } 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } }

    .t-hero-mid { flex: 1 1 220px; min-width: 0; }
    .t-meta { display: flex; flex-wrap: wrap; gap: .4rem .6rem; align-items: center; color: var(--ink-2); font-size: .95rem; }
    .t-meta .sep { color: var(--muted); }
    .t-title { margin: .3rem 0 0; font-size: 1.5rem; }

    .t-hero-side { display: flex; flex-direction: column; align-items: flex-end; gap: .6rem; }
    .t-countdown { color: var(--ink-2); font-size: .95rem; }
    .t-countdown strong { font-variant-numeric: tabular-nums; color: var(--ink); font-size: 1.05rem; }
    .t-parts { display: inline-flex; align-items: center; gap: .6rem; background: var(--surface-2); border-radius: var(--r-pill); padding: .4rem .9rem; color: var(--ink-2); font-weight: 600; }
    .t-ava-row { display: inline-flex; }
    .t-ava { width: 28px; height: 28px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; font-size: 1rem; border: 2px solid var(--surface); margin-left: -10px; box-shadow: var(--shadow-sm); }
    .t-ava-row .t-ava:first-child { margin-left: 0; }
    .t-badge { font-size: .9rem; }

    .btn-join { background: #21b85a; color: #fff; font-weight: 700; border: none; padding: .7rem 1.6rem; border-radius: var(--r-md); cursor: pointer; }
    .btn-join:hover { background: #1ca350; }

    /* ----- Заголовок секции «Партии» + «Все игры» ----- */
    .sec-head { display: flex; align-items: baseline; justify-content: space-between; margin: 1.8rem 0 1rem; }
    .sec-title { font-size: 1.5rem; margin: 0; }
    .all-games { color: var(--accent); font-weight: 700; }
    .all-games:hover { text-decoration: underline; }

    /* ----- Трансляция партий ----- */
    .boards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.2rem; }
    .bcard { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 12px; box-shadow: var(--shadow-sm); }
    .bcard.done { opacity: .9; }
    .bplayer { display: flex; align-items: center; gap: .5rem; padding: .15rem 0; }
    .bava { width: 26px; height: 26px; border-radius: 50%; background: var(--surface-2); display: grid; place-items: center; font-size: .95rem; flex: none; }
    .bname { font-weight: 650; font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bscore { margin-left: auto; font-weight: 800; font-variant-numeric: tabular-nums; }
    .bclock { align-self: flex-end; font-variant-numeric: tabular-nums; font-size: .82rem; font-weight: 600; color: var(--ink-2); background: var(--surface-2); border-radius: var(--r-sm); padding: .05rem .45rem; margin: .15rem 0; display: inline-block; }
    .bclock.active { background: var(--ink); color: #fff; }
    .bboard { position: relative; margin: .35rem 0; }
    .bboard .board-wrap { width: 100%; }
    .bresult { position: absolute; inset: 0; margin: auto; width: max-content; height: max-content; display: flex; align-items: center; gap: .15rem; }
    .bresult .rcell { width: 48px; height: 60px; display: grid; place-items: center; font-size: 2rem; font-weight: 800; box-shadow: var(--shadow-md); }
    .bresult .rcell.w { background: #fff; color: #111; }
    .bresult .rcell.b { background: #111; color: #fff; }
    .bresult .rdash { color: #fff; font-weight: 800; text-shadow: 0 1px 4px rgba(0,0,0,.6); }

    /* ----- Своя партия ----- */
    .my-game { margin-top: 1.2rem; }
    .my-game .players { display: flex; flex-direction: column; gap: .35rem; margin-bottom: .75rem; font-size: 1.05rem; }
    .my-game .board-wrap { position: relative; width: min(92vw, 448px); }
    .clock { font-variant-numeric: tabular-nums; padding: .1rem .5rem; border-radius: var(--r-sm); background: var(--surface-2); color: var(--ink); font-weight: 600; margin-left: .4rem; }
    .clock.active { background: var(--accent); color: #fff; }
    .gstatus { margin-top: .85rem; display: flex; gap: .6rem; align-items: center; }
    .waiting { text-align: center; padding: 2.5rem 1rem; font-size: 1.05rem; color: var(--ink-2); margin-top: 1.2rem; }
    .search-anim { position: relative; width: 76px; height: 76px; margin: 0 auto .9rem; display: grid; place-items: center; }
    .search-ring { position: absolute; inset: 0; border-radius: 50%; border: 3px solid var(--accent); border-top-color: transparent; animation: search-spin 1s linear infinite; }
    .search-ring::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); animation: search-pulse 1.6s ease-out infinite; }
    .search-piece { width: 42px; height: 42px; display: block; animation: search-bob 1.6s ease-in-out infinite; }
    .search-piece .cp { width: 100%; height: 100%; display: block; }
    .search-text { font-weight: 600; color: var(--ink); }
    .search-text .dots { display: inline-block; letter-spacing: .05em; }
    .search-text .dots i { display: inline-block; opacity: .2; animation: search-dot 1.4s infinite; }
    .search-text .dots i::before { content: "."; }
    .search-text .dots i:nth-child(2) { animation-delay: .2s; }
    .search-text .dots i:nth-child(3) { animation-delay: .4s; }
    @@keyframes search-spin { to { transform: rotate(360deg); } }
    @@keyframes search-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); } 100% { box-shadow: 0 0 0 18px transparent; } }
    @@keyframes search-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @@keyframes search-dot { 0%, 60%, 100% { opacity: .2; } 30% { opacity: 1; } }
    @@media (prefers-reduced-motion: reduce) {
        .search-ring, .search-ring::after, .search-piece, .search-text .dots i { animation: none; }
        .search-ring { border-top-color: var(--accent); }
        .search-text .dots i { opacity: 1; }
    }
    .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 16px; box-shadow: var(--shadow-sm); }

    /* ----- Доска (клиентский рендер: серверный Chessboard здесь не рендерится) ----- */
    .board { display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr); width: 100%; aspect-ratio: 1 / 1; border-radius: 6px; overflow: hidden; box-shadow: var(--shadow-md); }
    .board .sq { position: relative; border: none; padding: 0; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .board.mini .sq { cursor: default; }
    .sq.light { background: #ecd6b3; }
    .sq.dark { background: #b58863; }
    .sq.hl.light { background: #cdd279; }
    .sq.hl.dark { background: #aaa23a; }
    .sq.chk { background: radial-gradient(circle at center, #ff8a7a 0%, #d23b2e 80%); }
    .sq.sel { outline: 3px solid var(--accent); outline-offset: -3px; }
    .coord { position: absolute; font-size: clamp(8px, 2.2vw, 11px); font-weight: 700; line-height: 1; user-select: none; pointer-events: none; }
    .coord.rank { top: 3px; left: 4px; }
    .coord.file { bottom: 2px; right: 4px; }
    .coord.on-light { color: #b58863; }
    .coord.on-dark { color: #ecd6b3; }
    .piece-img { width: 90%; height: 90%; display: block; }
    .promo { position: absolute; top: 35%; left: 50%; transform: translateX(-50%); display: flex; gap: .25rem; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: .4rem; box-shadow: 0 8px 24px rgba(0,0,0,.25); z-index: 2; }
    .promo-btn { width: 48px; height: 48px; padding: 4px; border: 1px solid var(--line); background: var(--surface-2); border-radius: 6px; cursor: pointer; }
    .promo-btn .cp { width: 100%; height: 100%; }

    /* ----- Таблица лидеров ----- */
    .podium { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 1.6rem 0 1.2rem; }
    .pod { background: var(--surface-2); border-radius: var(--r-lg); padding: 1.2rem 1rem; text-align: center; }
    .pod-cup { font-size: 2.4rem; line-height: 1; }
    .pod-name { font-weight: 700; margin-top: .5rem; }
    .pod-stat { color: var(--muted); font-size: .85rem; margin-top: .2rem; }
    .pod.gold { order: 2; background: #fff7e0; }
    .pod.silver { order: 1; }
    .pod.bronze { order: 3; background: #f6ede4; }

    .st-list { display: flex; flex-direction: column; gap: 12px; }
    .st-card { background: var(--surface-2); border-radius: var(--r-lg); padding: 14px 16px; }
    .st-head { display: flex; align-items: center; gap: .7rem; }
    .st-ava { width: 36px; height: 36px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; font-size: 1.2rem; flex: none; }
    .st-name { font-weight: 680; font-size: 1.05rem; display: inline-flex; align-items: center; gap: .4rem; }
    .st-name .fire { color: var(--danger); font-size: .9rem; font-weight: 700; }
    .st-place { margin-left: auto; color: var(--ink-2); font-weight: 600; }
    .st-score { font-weight: 800; font-size: 1.1rem; min-width: 2ch; text-align: right; }
    .st-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; padding-left: calc(36px + .7rem); }
    .chip { font-weight: 700; font-size: .95rem; font-variant-numeric: tabular-nums; min-width: 1.1ch; text-align: center; }
    .chip.c-win { color: var(--success); }
    .chip.c-bonus { color: var(--warn); }
    .chip.c-draw { color: var(--ink-2); }
    .chip.c-loss { color: var(--muted); }

    /* ----- Правила начисления (правая колонка) ----- */
    .score-rules .card-title { font-size: 1.3rem; margin: 0 0 1rem; }
    .sr-sub { font-weight: 700; color: var(--ink); margin-bottom: .6rem; }
    .sr-row { display: flex; justify-content: space-between; padding: .55rem 0; border-bottom: 1px solid var(--line); }
    .sr-row strong { font-variant-numeric: tabular-nums; }
    .sr-bonus { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; background: var(--warn-weak); color: var(--warn); font-weight: 700; padding: .7rem 1rem; border-radius: var(--r-md); }

    /* На узких экранах правая колонка уезжает вниз (после контента). */
    @@media (max-width: 900px) {
        .t-grid { grid-template-columns: 1fr; }
        .t-side { position: static; }
        .t-hero-side { align-items: flex-start; width: 100%; }
        .podium { grid-template-columns: 1fr; }
        .pod.gold, .pod.silver, .pod.bronze { order: 0; }
        .st-chips { padding-left: 0; }
    }

    @@media (max-width: 560px) {
        .t-hero { gap: .9rem; }
        .t-thumb { width: 100%; aspect-ratio: 16 / 7; }
        .t-title { font-size: 1.3rem; }
        .t-hero-side { align-items: stretch; }
        .t-hero-side .btn-join { width: 100%; }
        .t-parts { justify-content: center; }
        .boards-grid { grid-template-columns: 1fr; }
        .sec-head { flex-wrap: wrap; gap: .3rem; }
        .crumbs { font-size: .85rem; }
    }
</style>
