@page "/t/{Id}"
@using ChessSchool.Arena
@using ChessSchool.Arena.Grains
@using ChessSchool.Contracts
@inject IHttpContextAccessor Http
@inject IGrainFactory Grains
@inject NavigationManager Nav
@inject ChessSchool.Arena.Services.BrandTournamentCatalog BrandCatalog

@* Страница турнира на «тонком» клиенте: статический SSR-каркас без серверной Blazor-цепи и без
   ре-рендеров по таймеру. Шапку/таблицу/доски/свою партию рендерит браузерный JS (tournament.js),
   синхронизация — SignalR прямо к /arenahub (cookie-auth, тот же origin), часы анимируются локально.
   Это снимает «состояние на зрителя» с веб-сервера (масштаб) и переживает плохую сеть (reconnect → ресинк). *@

<PageTitle>@Loc.T("t.fallback") — ChessArena</PageTitle>
<HeadContent>
    @* Предзагрузка клиентских библиотек параллельно с HTML: к моменту запуска тонкого клиента они
       уже в кэше → доска/кнопки появляются сразу, без ожидания загрузки модулей (важно на медленном
       интернете). Тот же fingerprinted-URL, что и в import ниже (#t-root data-*) → одна загрузка + immutable-кэш. *@
    <link rel="modulepreload" href="@Assets["lib/signalr.js"]" />
    <link rel="modulepreload" href="@Assets["lib/chess.js"]" />
    @* Регулярные турниры расписания эфемерны → noindex. Бренд-турниры (кураторские, стабильный slug)
       индексируются. Признак — из IBrandTournaments (пока брендов нет → всё noindex). *@
    @if (_indexable && _brand is not null)
    {
        <meta name="robots" content="index,follow" />
        <link rel="canonical" href="@Canonical" />
        <meta name="description" content="@_brand.Description" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@_brand.Name" />
        <meta property="og:description" content="@_brand.Description" />
        <meta property="og:url" content="@Canonical" />
        <meta property="og:image" content="@(string.IsNullOrWhiteSpace(_brand.ImageUrl) ? $"{Nav.BaseUri}og-image.png" : _brand.ImageUrl)" />
        <meta name="twitter:card" content="summary_large_image" />
        <script type="application/ld+json">@((MarkupString)BrandJsonLd(_brand))</script>
    }
    else
    {
        <meta name="robots" content="noindex" />
    }
</HeadContent>

@{
    var authed = Http.HttpContext?.User?.Identity?.IsAuthenticated == true;
}

<nav class="crumbs">
    <a href="/">@Loc.T("crumb.home")</a><span>›</span>
    <a href="/">@Loc.T("nav.arena")</a><span>›</span>
    <span class="crumbs-cur" id="t-crumb"></span>
</nav>

<div class="t-grid">
    @* Начальный снимок состояния рендерится на сервере (один stateless-запрос к грейну): страница
       показывает контент сразу и без JS (SEO/первый кадр). JS при подключении заменяет на живую версию. *@
    <div class="t-main" id="t-main">
        @if (_initial is null)
        {
            <p class="text-muted"><em>@Loc.T("loading")</em></p>
        }
        else
        {
            var s = _initial;
            var running = s.Status == TournamentStatus.Running;
            <div class="t-hero card">
                <div class="t-thumb @(running ? "" : "dim")">
                    @if (running)
                    {
                        <span class="t-live"><span class="t-dot"></span>Live</span>
                    }
                    else
                    {
                        <span class="t-live past">@(s.Status == TournamentStatus.Finished ? Loc.T("t.finished") : Loc.T("t.soon"))</span>
                    }
                </div>
                <div class="t-hero-mid">
                    <div class="t-meta">
                        <span>@s.StartedAt.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</span><span class="sep">•</span>
                        <span>@(s.DurationSeconds / 60) @Loc.T("t.minutes")</span><span class="sep">•</span>
                        <span>@Loc.T("t.control") @(s.TimeControl.InitialSeconds / 60) + @s.TimeControl.IncrementSeconds</span>
                    </div>
                    <h1 class="t-title">@s.Name</h1>
                </div>
                <div class="t-hero-side">
                    @if (running)
                    {
                        <div class="t-countdown">@Loc.T("t.endin") <strong>@Hms(s.SecondsLeft)</strong></div>
                    }
                    else if (s.Status == TournamentStatus.Created)
                    {
                        <div class="t-countdown">@Loc.T("t.start") <strong>@s.StartedAt.ToLocalTime().ToString("dd.MM, HH:mm")</strong></div>
                    }
                    <div class="t-parts">
                        <span class="t-ava-row">@foreach (var st in s.Standings.Take(3)) { <span class="t-ava">@Avatar(st.Name)</span> }</span>
                        <span>@s.Standings.Count @Loc.Participants(s.Standings.Count)</span>
                    </div>
                    @if (!authed && s.Status != TournamentStatus.Finished)
                    {
                        <a class="btn btn-join" href="/signin?returnUrl=/t/@Id" data-enhance-nav="false">@(s.Status == TournamentStatus.Created ? Loc.T("act.loginreg") : Loc.T("act.login"))</a>
                    }
                </div>
            </div>

            @if (s.Standings.Count > 0)
            {
                <div class="podium">
                    @foreach (var p in s.Standings.Take(3))
                    {
                        <div class="pod @PodClass(p.Rank)">
                            <div class="pod-cup">@Trophy(p.Rank)</div>
                            <div class="pod-name">@p.Name@if (p.IsBot) { <span class="bot-tag">@Loc.T("bot.tag")</span> }</div>
                            <div class="pod-stat">@p.Games @Loc.T("pod.games") • @p.Wins @Loc.T("pod.wins") • @p.Score @Loc.T("pod.pts")</div>
                        </div>
                    }
                </div>
                <div class="st-list">
                    @foreach (var st in s.Standings)
                    {
                        <div class="st-card">
                            <div class="st-head">
                                <span class="st-ava">@Avatar(st.Name)</span>
                                <span class="st-name">@st.Name@if (st.IsBot) { <span class="bot-tag">@Loc.T("bot.tag")</span> } @if (st.OnFire) { <span class="fire">🔥 @st.Streak</span> }</span>
                                <span class="st-place">@st.Rank @Loc.T("st.place")</span>
                                <span class="st-score">@st.Score</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <aside class="t-side">
        @* «Напомнить» для предстоящего бренд-турнира — добавить в календарь (.ics). Вне #t-main → переживает JS. *@
        @if (_brand is not null && _initial?.Status == TournamentStatus.Created)
        {
            <a class="card bt-remind" href="/t/@Id/calendar.ics">
                <span class="bt-remind-ic">🔔</span>
                <span class="bt-remind-tx">
                    <strong>@Loc.T("bt.remind")</strong>
                    <span>@Loc.T("bt.remind.hint")</span>
                </span>
            </a>
        }
        <div class="card score-rules">
            <h3 class="card-title">@Loc.T("rules.title")</h3>
            <div class="sr-sub">@Loc.T("rules.sub")</div>
            <div class="sr-row"><span>@Loc.T("rules.win")</span><strong>+ 2</strong></div>
            <div class="sr-row"><span>@Loc.T("rules.draw")</span><strong>+ 1</strong></div>
            <div class="sr-row"><span>@Loc.T("rules.loss")</span><strong>0</strong></div>

            <div class="sr-sub sr-sub-bonus">@Loc.T("rules.bonuses")</div>
            <div class="sr-bonus">
                <span class="sr-bonus-info">
                    <span class="sr-bonus-name">🔥 @Loc.T("rules.streak.name")</span>
                    <span class="sr-bonus-cond">@Loc.T("rules.streak.cond")</span>
                </span>
                <strong>@Loc.T("rules.streak.eff")</strong>
            </div>
            <div class="sr-bonus">
                <span class="sr-bonus-info">
                    <span class="sr-bonus-name">⚡ @Loc.T("rules.berserk.name")</span>
                    <span class="sr-bonus-cond">@Loc.T("rules.berserk.cond")</span>
                </span>
                <strong>@Loc.T("rules.berserk.eff")</strong>
            </div>
        </div>
    </aside>
</div>

<div id="t-root" data-id="@Id" data-authed="@(authed ? "1" : "0")" data-loginurl="/signin?returnUrl=/t/@Id"
     data-chess="@Assets["lib/chess.js"]" data-signalr="@Assets["lib/signalr.js"]"></div>
<script id="t-loc" type="application/json">@((MarkupString)LocJson())</script>
@* tournament.js подключён глобально в App.razor (исполняется и при enhanced-навигации). *@

@code {
    [Parameter] public string Id { get; set; } = "";

    private ArenaStateDto? _initial;
    private BrandTournament? _brand;
    private bool _indexable;
    private string Canonical => $"{Nav.BaseUri}t/{Id}";

    // Начальное состояние для SSR — один stateless-запрос к грейну (контент сразу и без JS, для SEO).
    // Грейн недоступен/неизвестный id → каркас «Загрузка…», дальше JS дорисует по SignalR.
    protected override async Task OnInitializedAsync()
    {
        _brand = await BrandCatalog.BySlugAsync(Id);   // бренд-турнир → индексируется + богатая мета
        _indexable = _brand is { Visible: true };
        try
        {
            var sub = Http.HttpContext?.User?.FindFirst("sub")?.Value ?? "";
            _initial = await Grains.GetGrain<IArenaTournamentGrain>(Id).GetStateAsync(sub);
        }
        catch
        {
            _initial = null;
        }
    }

    private static string Hms(int seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return $"{(int)t.TotalHours:D2}:{t.Minutes:D2}:{t.Seconds:D2}";
    }

    private static string Trophy(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => rank.ToString() };
    private static string PodClass(int rank) => rank switch { 1 => "gold", 2 => "silver", 3 => "bronze", _ => "" };

    private static readonly string[] Avatars = ["👶", "🧑", "🧔", "🧓", "👩", "🧒", "👨", "👧"];
    private static string Avatar(string name)
    {
        int h = 0;
        foreach (var ch in name) h = (h * 31 + ch) & 0x7fffffff;
        return Avatars[h % Avatars.Length];
    }

    // schema.org Event для бренд-турнира (rich-результаты + шеринг). Только для индексируемых страниц.
    private string BrandJsonLd(BrandTournament b)
    {
        var graph = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Event",
            ["name"] = b.Name,
            ["description"] = b.Description,
            ["startDate"] = b.StartsAt.ToString("o"),
            ["endDate"] = b.StartsAt.AddSeconds(b.DurationSeconds).ToString("o"),
            ["eventAttendanceMode"] = "https://schema.org/OnlineEventAttendanceMode",
            ["eventStatus"] = "https://schema.org/EventScheduled",
            ["url"] = Canonical,
            ["image"] = string.IsNullOrWhiteSpace(b.ImageUrl) ? $"{Nav.BaseUri}og-image.png" : b.ImageUrl,
            ["organizer"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "ChessArena", ["url"] = Nav.BaseUri },
        };
        return System.Text.Json.JsonSerializer.Serialize(graph, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        });
    }

    // Локализованные строки + формы множественного числа для клиентского JS (на язык запроса).
    private static string LocJson()
    {
        var l = new Dictionary<string, string>
        {
            ["loading"] = Loc.T("loading"),
            ["finished"] = Loc.T("t.finished"),
            ["soon"] = Loc.T("t.soon"),
            ["minutes"] = Loc.T("t.minutes"),
            ["control"] = Loc.T("t.control"),
            ["endin"] = Loc.T("t.endin"),
            ["start"] = Loc.T("t.start"),
            ["loginreg"] = Loc.T("act.loginreg"),
            ["login"] = Loc.T("act.login"),
            ["join"] = Loc.T("act.join"),
            ["injoined"] = Loc.T("act.injoined"),
            ["register"] = Loc.T("act.register"),
            ["registered"] = Loc.T("act.registered"),
            ["seek"] = Loc.T("act.seek"),
            ["search"] = Loc.T("waiting.search"),
            ["score"] = Loc.T("waiting.score"),
            ["yourmove"] = Loc.T("game.yourmove"),
            ["oppmove"] = Loc.T("game.oppmove"),
            ["berserktip"] = Loc.T("game.berserktip"),
            ["resign"] = Loc.T("game.resign"),
            ["drawoffer"] = Loc.T("game.drawoffer"),
            ["drawoffered"] = Loc.T("game.drawoffered"),
            ["drawincoming"] = Loc.T("game.drawincoming"),
            ["drawaccept"] = Loc.T("game.drawaccept"),
            ["drawdecline"] = Loc.T("game.drawdecline"),
            ["drawdeclined"] = Loc.T("game.drawdeclined"),
            ["games"] = Loc.T("sec.games"),
            ["allgames"] = Loc.T("link.allgames"),
            ["reswhite"] = Loc.T("res.white"),
            ["resblack"] = Loc.T("res.black"),
            ["resdraw"] = Loc.T("res.draw"),
            ["place"] = Loc.T("st.place"),
            ["podgames"] = Loc.T("pod.games"),
            ["podwins"] = Loc.T("pod.wins"),
            ["podpts"] = Loc.T("pod.pts"),
            ["bottag"] = Loc.T("bot.tag"),
            // Формы множественного числа «участник(а/ов)» — переиспользуем серверную логику Loc.Participants.
            ["participant_one"] = Loc.Participants(1),
            ["participant_few"] = Loc.Participants(2),
            ["participant_many"] = Loc.Participants(5),
        };
        return System.Text.Json.JsonSerializer.Serialize(new { l, isEn = Loc.IsEn },
            new System.Text.Json.JsonSerializerOptions
            {
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
    }
}
