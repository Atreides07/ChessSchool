<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Обход бага Razor source-generator в .NET SDK 10.0.300: на холодной (полной) генерации
         компонентов с @rendermode партиал render-mode-атрибута не эмитится, и сборка валится
         сотнями ложных ошибок (валидная разметка парсится как C#). Классический компайл-тайм
         кодоген Razor даёт идентичный рантайм и собирается стабильно. Убрать, когда SDK починят. -->
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessSchool.ServiceDefaults\ChessSchool.ServiceDefaults.csproj" />
    <ProjectReference Include="..\ChessSchool.Contracts\ChessSchool.Contracts.csproj" />
    <ProjectReference Include="..\ChessSchool.WebAuth\ChessSchool.WebAuth.csproj" />
    <ProjectReference Include="..\ChessSchool.Design\ChessSchool.Design.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
  </ItemGroup>

</Project>
