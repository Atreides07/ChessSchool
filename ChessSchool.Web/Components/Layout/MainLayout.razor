@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using ChessSchool.Web
@inject NavigationManager Nav

<div class="ds-app">
    <header class="ds-topbar">
        <a class="ds-brand" href="/">
            <span class="logo">
                <svg viewBox="0 0 45 45" width="16" height="16" fill="#fff"><path d="M18 10c1-1 3-2 5-2 7 0 12 6 12 16v14H13c0-6 3-9 7-12-2 1-5 2-7 1-2-1-2-3-1-5-2 1-4 1-5-1-1-3 1-5 4-7 .5-1 1-2 0-3 1-1 2-1 3 0z"/></svg>
            </span>
            ChessSchool
        </a>
        <nav class="ds-nav">
            <NavLink class="ds-navlink" href="" Match="NavLinkMatch.All">@Loc.T("nav.home")</NavLink>
            <NavLink class="ds-navlink" href="school">@Loc.T("nav.school")</NavLink>
            <NavLink class="ds-navlink" href="attribution">@Loc.T("nav.attribution")</NavLink>
            <NavLink class="ds-navlink" href="play">@Loc.T("nav.play")</NavLink>
        </nav>
        <span class="ds-spacer"></span>
        <div class="ds-lang" role="group" aria-label="Язык / Language">
            <a href="@LangHref("ru")" class="@(Loc.IsEn ? "" : "on")">RU</a>
            <a href="@LangHref("en")" class="@(Loc.IsEn ? "on" : "")">EN</a>
        </div>
        <AuthorizeView>
            <Authorized>
                <ChessSchool.Design.UserMenu Name="@context.User.Identity?.Name"
                                             Email='@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? context.User.FindFirst("email")?.Value)'
                                             SignOutHref="/signout" />
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary btn-sm" href="/signin?returnUrl=/play">@Loc.T("auth.login")</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="ds-container">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    Произошла ошибка.
    <a href="" class="reload">Перезагрузить</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .ds-lang { display: inline-flex; gap: 2px; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-pill); padding: 2px; }
    .ds-lang a { font-size: .78rem; font-weight: 700; color: var(--ink-2); padding: .22rem .5rem; border-radius: var(--r-pill); line-height: 1; }
    .ds-lang a.on { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-sm); }
    .ds-lang a:hover { color: var(--ink); }
</style>

@code {
    private string LangHref(string culture)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
        return $"/lang?culture={culture}&returnUrl={Uri.EscapeDataString(path)}";
    }
}
