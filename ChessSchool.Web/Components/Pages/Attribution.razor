@page "/attribution"
@rendermode InteractiveServer
@attribute [Authorize]
@using ChessSchool.Web
@using Microsoft.AspNetCore.Authorization
@inject SchoolApiClient Api

<PageTitle>@Loc.T("attr.pagetitle")</PageTitle>

<h1>@Loc.T("attr.h1")</h1>
<p class="text-muted">@Loc.T("attr.intro")</p>

@if (_pending is null || _students is null)
{
    <p><em>@Loc.T("loading")</em></p>
}
else if (_pending.Count == 0)
{
    <div class="alert alert-success">@Loc.T("attr.empty")</div>
}
else
{
    @foreach (var g in _pending)
    {
        <div class="pending-card">
            <div class="meta">
                <span>@Loc.T("attr.board") <strong>@g.DeviceRef</strong></span>
                <span>@g.PlayedAt.LocalDateTime.ToString("dd.MM HH:mm")</span>
            </div>
            <code>@g.Pgn</code>
            <div class="assign">
                <label>@Loc.T("attr.white")
                    <select @bind="_form[g.Id].White">
                        <option value="">—</option>
                        @foreach (var s in _students) { <option value="@s.Id">@s.DisplayName</option> }
                    </select>
                </label>
                <label>@Loc.T("attr.black")
                    <select @bind="_form[g.Id].Black">
                        <option value="">—</option>
                        @foreach (var s in _students) { <option value="@s.Id">@s.DisplayName</option> }
                    </select>
                </label>
                <label>@Loc.T("attr.result")
                    <select @bind="_form[g.Id].Result">
                        <option value="@GameResult.WhiteWins">1–0</option>
                        <option value="@GameResult.Draw">½–½</option>
                        <option value="@GameResult.BlackWins">0–1</option>
                    </select>
                </label>
                <button class="btn btn-primary btn-sm" @onclick="() => Attribute(g.Id)">@Loc.T("attr.save")</button>
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<PendingGameDto>? _pending;
    private IReadOnlyList<StudentDto>? _students;
    private Guid _schoolId;
    private string? _sub;
    private readonly Dictionary<Guid, Form> _form = [];

    private sealed class Form { public string White = ""; public string Black = ""; public GameResult Result = GameResult.WhiteWins; }

    protected override async Task OnInitializedAsync()
    {
        _sub = AuthState is null ? null : (await AuthState).User.FindFirst("sub")?.Value;
        if (_sub is null) return;
        var my = await Api.GetOrCreateMySchoolAsync(_sub);
        if (my is null) return;
        _schoolId = my.SchoolId;
        await Load();
    }

    private async Task Load()
    {
        _students = await Api.GetStudentsAsync(_schoolId, _sub!);
        _pending = await Api.GetPendingAsync(_schoolId, _sub!);
        foreach (var g in _pending)
            _form.TryAdd(g.Id, new Form());
    }

    private async Task Attribute(Guid gameId)
    {
        var f = _form[gameId];
        if (!Guid.TryParse(f.White, out var w) || !Guid.TryParse(f.Black, out var bl) || w == bl) return;
        await Api.AttributeAsync(gameId, new AttributeGameRequest(w, bl, f.Result), _sub!);
        await Load();
    }
}

<style>
    .pending-card { border: 1px solid #e0e0e0; border-radius: 10px; padding: 1rem; margin-bottom: 1rem; }
    .meta { display: flex; justify-content: space-between; color: #666; }
    .assign { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-top: .75rem; }
</style>
