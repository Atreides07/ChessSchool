@page "/"
@using ChessSchool.Web
@inject NavigationManager Nav

<PageTitle>@Loc.T("home.pagetitle")</PageTitle>
<HeadContent>
    <meta name="description" content="@Loc.T("home.metadesc")" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@Nav.BaseUri" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@Loc.T("home.pagetitle")" />
    <meta property="og:description" content="@Loc.T("home.metadesc")" />
    <meta property="og:url" content="@Nav.BaseUri" />
    <meta property="og:image" content="@($"{Nav.BaseUri}og-image.png")" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">
        {"@@context":"https://schema.org","@@type":"Organization","name":"ChessSchool","url":"@Nav.BaseUri","logo":"@($"{Nav.BaseUri}og-image.png")"}
    </script>
</HeadContent>

<section class="hero">
    <span class="eyebrow">@Loc.T("home.eyebrow")</span>
    <h1>@Loc.T("home.h1")</h1>
    <p class="lead">@Loc.T("home.lead")</p>
    <div class="row row-wrap">
        <a class="btn btn-primary btn-lg" href="school">@Loc.T("home.cta.school")</a>
        <a class="btn btn-ghost btn-lg" href="play">@Loc.T("home.cta.play")</a>
    </div>
</section>

<div class="grid grid-auto mt-3">
    <div class="card">
        <h3 class="card-title">@Loc.T("home.c1.title")</h3>
        <p class="text-secondary">@Loc.T("home.c1.desc")</p>
        <a href="school">@Loc.T("home.c1.link")</a>
    </div>
    <div class="card">
        <h3 class="card-title">@Loc.T("home.c2.title")</h3>
        <p class="text-secondary">@Loc.T("home.c2.desc")</p>
        <a href="play">@Loc.T("home.c2.link")</a>
    </div>
    <div class="card">
        <h3 class="card-title">@Loc.T("home.c3.title")</h3>
        <p class="text-secondary">@Loc.T("home.c3.desc")</p>
        <a href="attribution">@Loc.T("home.c3.link")</a>
    </div>
</div>
