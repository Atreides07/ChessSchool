@page "/play"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Authorization
@using ChessSchool.WebAuth
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthState
@implements IAsyncDisposable

<PageTitle>Играть онлайн</PageTitle>
<h1>Онлайн-партия</h1>

@if (!_authenticated)
{
    <div class="login">
        <p class="text-muted">Войдите единым аккаунтом ChessSchool ID, чтобы играть.</p>
        <a class="btn btn-primary" href="/signin?returnUrl=/play">Войти через ChessSchool ID</a>
    </div>
}
else if (_state is null)
{
    <p>Вы вошли как <strong>@_name</strong>.</p>
    @if (_searching)
    {
        <p><em>Ищем соперника…</em></p>
    }
    else
    {
        <button class="btn btn-primary" @onclick="FindMatch">Найти соперника (блиц 5+2)</button>
    }
    @if (_error is not null) { <div class="alert alert-danger">@_error</div> }
}
else
{
    <div class="game">
        <div class="players">
            <span>♟️ @_state.BlackPlayerName — <span class="clock @(ActiveBlack ? "active" : "")">@Clock(EffectiveMs(false))</span></span>
            <span>♙ @_state.WhitePlayerName — <span class="clock @(ActiveWhite ? "active" : "")">@Clock(EffectiveMs(true))</span></span>
        </div>

        <Chessboard Fen="@_state.Fen" FlipForBlack="_color == PieceColor.Black"
                    LastFrom="@_state.LastFrom" LastTo="@_state.LastTo" CheckSquare="@_state.CheckSquare"
                    Disabled="!MyTurn" OnMove="DoMove" />

        <div class="status">
            @if (_state.Status == GameStatus.Finished)
            {
                <strong>Партия завершена: @ResultText() (@_state.EndReason)</strong>
            }
            else
            {
                <span>@(MyTurn ? "Ваш ход" : "Ход соперника")</span>
                <button class="btn btn-sm btn-outline-danger" @onclick="Resign">Сдаться</button>
            }
        </div>
        @if (_error is not null) { <div class="alert alert-warning">@_error</div> }
    </div>
}

@code {
    private bool _authenticated;
    private string _name = "Игрок";
    private string? _token;
    private string? _error;
    private bool _searching;

    private HubConnection? _conn;
    private GameStateDto? _state;
    private DateTimeOffset _stateAt;
    private string? _gameId;
    private PieceColor? _color;
    private PeriodicTimer? _ticker;

    private bool MyTurn => _state is { Status: GameStatus.InProgress } && _state.Turn == _color;
    private bool ActiveWhite => _state is { Status: GameStatus.InProgress, Turn: PieceColor.White };
    private bool ActiveBlack => _state is { Status: GameStatus.InProgress, Turn: PieceColor.Black };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _authenticated = true;
            _name = user.Identity.Name ?? "Игрок";
            _token = user.FindFirst(SsoExtensions.AccessTokenClaim)?.Value;
            await Connect();
        }
    }

    private void SetState(GameStateDto? s)
    {
        _state = s;
        _stateAt = DateTimeOffset.UtcNow;
    }

    private long EffectiveMs(bool white)
    {
        if (_state is null) return 0;
        long baseMs = white ? _state.WhiteMs : _state.BlackMs;
        bool active = _state.Status == GameStatus.InProgress &&
                      ((white && _state.Turn == PieceColor.White) || (!white && _state.Turn == PieceColor.Black));
        if (!active) return baseMs;
        return baseMs - (long)(DateTimeOffset.UtcNow - _stateAt).TotalMilliseconds;
    }

    private async Task Connect()
    {
        var baseUrl = Config["services:gameserver:https:0"] ?? Config["services:gameserver:http:0"];
        _conn = new HubConnectionBuilder()
            .WithUrl($"{baseUrl}/gamehub", opts => opts.AccessTokenProvider = () => Task.FromResult(_token)!)
            .WithAutomaticReconnect()
            .Build();

        _conn.On<GameStateDto>("GameState", s =>
        {
            SetState(s);
            return InvokeAsync(StateHasChanged);
        });

        await _conn.StartAsync();
        _ = RunClockAsync();
    }

    private async Task RunClockAsync()
    {
        _ticker = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
        while (await _ticker.WaitForNextTickAsync())
        {
            if (_state is { Status: GameStatus.InProgress })
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FindMatch()
    {
        if (_conn is null) return;
        _searching = true; _error = null;
        try
        {
            var found = await _conn.InvokeAsync<MatchFound>("FindMatch", 300, 2);
            _gameId = found.GameId;
            _color = found.Color;
            SetState(await _conn.InvokeAsync<GameStateDto?>("JoinGame", _gameId));
        }
        catch (Exception)
        {
            _error = "Соперник не найден за отведённое время. Попробуйте ещё раз.";
        }
        finally { _searching = false; }
    }

    private async Task DoMove((string From, string To, string? Promotion) m)
    {
        if (_conn is null || _gameId is null) return;
        var result = await _conn.InvokeAsync<MoveResult>("Move", _gameId, m.From, m.To, m.Promotion);
        if (!result.Accepted) _error = result.Error;
        else { _error = null; if (result.State is not null) SetState(result.State); }
    }

    private async Task Resign()
    {
        if (_conn is not null && _gameId is not null)
            SetState(await _conn.InvokeAsync<GameStateDto>("Resign", _gameId));
    }

    private string ResultText() => _state!.Result switch
    {
        GameResult.WhiteWins => "победили белые",
        GameResult.BlackWins => "победили чёрные",
        GameResult.Draw => "ничья",
        _ => "—"
    };

    private static string Clock(long ms)
    {
        var t = TimeSpan.FromMilliseconds(Math.Max(0, ms));
        return $"{t.Minutes:D2}:{t.Seconds:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        _ticker?.Dispose();
        if (_conn is not null) await _conn.DisposeAsync();
    }
}

<style>
    .login { max-width: 360px; display: flex; flex-direction: column; gap: .5rem; }
    .players { display: flex; flex-direction: column; gap: .25rem; margin-bottom: .5rem; font-size: 1.1rem; }
    .clock { font-variant-numeric: tabular-nums; padding: 0 .4rem; border-radius: 4px; background: #eee; }
    .clock.active { background: #1b6ec2; color: #fff; }
    .status { margin-top: .75rem; display: flex; gap: 1rem; align-items: center; }
</style>
