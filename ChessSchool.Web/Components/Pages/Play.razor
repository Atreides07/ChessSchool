@page "/play"
@using ChessSchool.Web
@inject IConfiguration Config

@* Онлайн-партия на «тонком» клиенте: статический SSR-каркас без .NET в браузере и без
   серверной Blazor-цепи. Правила и оптимистичный ход — chess.js локально, синхронизация —
   браузерный SignalR прямо к игровому хабу. Это снимает нагрузку «состояние на каждого игрока»
   с веб-сервера (масштаб) и переживает плохую сеть (reconnect → ресинк). *@

<PageTitle>@Loc.T("play.pagetitle")</PageTitle>

@{
    var authed = HttpContext?.User?.Identity?.IsAuthenticated == true;
    // За публичным адресом (dev tunnel) браузер должен бить в публичный URL gameserver, иначе —
    // внутренний адрес из service discovery.
    var hub = Config["GameServer:PublicUrl"] ?? Config["services:gameserver:https:0"]
        ?? Config["services:gameserver:http:0"] ?? "";
}

<h1>@Loc.T("play.h1")</h1>

@if (!authed)
{
    <div class="card ds-narrow">
        <p class="text-secondary">@Loc.T("play.loginprompt")</p>
        <a class="btn btn-primary" href="/signin?returnUrl=/play">@Loc.T("play.loginbtn")</a>
    </div>
}
else
{
    <div class="card game">
        <div id="status" class="status text-secondary">@Loc.T("play.connecting")</div>
        <div id="players" class="players"></div>
        <div class="board-wrap">
            <div id="board" class="board"></div>
            <div id="promo" class="promo" hidden></div>
        </div>
        <div class="controls">
            <button id="find" class="btn btn-primary">@Loc.T("play.find")</button>
            <button id="resign" class="btn btn-sm btn-outline-danger" hidden>@Loc.T("play.resign")</button>
        </div>
    </div>

    <script type="module">
        const HUB = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(hub));
        // Локализованные строки статусов (на язык запроса) — пробрасываем из сервера в клиентский JS.
        const L = {
            finished: @((MarkupString)J("play.finished")),
            yourMove: @((MarkupString)J("play.yourmove")),
            oppMove: @((MarkupString)J("play.oppmove")),
            whiteWon: @((MarkupString)J("play.whitewon")),
            blackWon: @((MarkupString)J("play.blackwon")),
            draw: @((MarkupString)J("play.draw")),
            reconnecting: @((MarkupString)J("play.reconnecting")),
            connected: @((MarkupString)J("play.connected")),
            searching: @((MarkupString)J("play.searching")),
            notFound: @((MarkupString)J("play.notfound")),
        };
        // Свежий токен берём с серверного эндпоинта (обновляется по refresh) — не вшиваем в страницу.
        const getToken = async () => {
            const r = await fetch('/api/game-token', { credentials: 'include' });
            return r.ok ? (await r.json()).access_token : '';
        };

        const { Chess } = await import('https://esm.sh/chess.js@1');
        const signalR = await import('https://esm.sh/@@microsoft/signalr@8');

        // Фигуры — тот же набор Cburnett, что и на серверной доске (статика из дизайн-системы).
        const PIECE_SRC = (p) => `_content/ChessSchool.Design/pieces/${p.color}${p.type.toUpperCase()}.svg`;
        const pieceImg = (p) => `<img class="cp" draggable="false" alt="" src="${PIECE_SRC(p)}">`;

        const boardEl = document.getElementById('board');
        const statusEl = document.getElementById('status');
        const playersEl = document.getElementById('players');
        const promoEl = document.getElementById('promo');
        const findBtn = document.getElementById('find');
        const resignBtn = document.getElementById('resign');

        const chess = new Chess();
        let gameId = null, myColor = 'w', flip = false, sel = null, finished = false;
        let lastState = null, stateAt = 0, pendingPromo = null;
        const cells = {}, coordHtml = {};

        const files = ['a','b','c','d','e','f','g','h'];
        function buildBoard() {
            boardEl.innerHTML = '';
            const ranks = flip ? [1,2,3,4,5,6,7,8] : [8,7,6,5,4,3,2,1];
            const cols = flip ? [...files].reverse() : files;
            for (const r of ranks) for (const f of cols) {
                const sq = f + r;
                const dark = (files.indexOf(f) + r) % 2 === 0;
                const el = document.createElement('div');
                el.className = 'sq ' + (dark ? 'dark' : 'light');
                el.dataset.sq = sq;
                el.onclick = () => onClick(sq);
                // Координаты: ранги по левому столбцу, файлы по нижней горизонтали (как на серверной доске).
                let cd = '';
                const tone = dark ? 'on-dark' : 'on-light';
                if (f === cols[0]) cd += `<span class="coord rank ${tone}">${r}</span>`;
                if (r === ranks[ranks.length - 1]) cd += `<span class="coord file ${tone}">${f}</span>`;
                coordHtml[sq] = cd;
                boardEl.appendChild(el);
                cells[sq] = el;
            }
        }

        function render(state) {
            if (state && state.fen) chess.load(state.fen);
            if (state) { lastState = state; stateAt = Date.now(); finished = state.status === 2; }
            for (const f of files) for (let r = 1; r <= 8; r++) {
                const sq = f + r, el = cells[sq];
                const p = chess.get(sq);
                el.innerHTML = coordHtml[sq] + (p ? pieceImg(p) : '');
                el.classList.remove('hl', 'chk', 'sel');
            }
            if (lastState) {
                if (lastState.lastFrom && cells[lastState.lastFrom]) cells[lastState.lastFrom].classList.add('hl');
                if (lastState.lastTo && cells[lastState.lastTo]) cells[lastState.lastTo].classList.add('hl');
                if (lastState.checkSquare && cells[lastState.checkSquare]) cells[lastState.checkSquare].classList.add('chk');
                statusEl.textContent = finished ? (L.finished + result(lastState.result))
                    : (chess.turn() === myColor ? L.yourMove : L.oppMove);
                resignBtn.hidden = finished;
            }
            renderClocks();
        }

        // Часы тикают локально между серверными апдейтами — плавный отсчёт без round-trip на каждый тик.
        function renderClocks() {
            if (!lastState) return;
            const ticking = lastState.status === 1;
            const elapsed = Date.now() - stateAt;
            const wActive = ticking && chess.turn() === 'w';
            const bActive = ticking && chess.turn() === 'b';
            const wms = lastState.whiteMs - (wActive ? elapsed : 0);
            const bms = lastState.blackMs - (bActive ? elapsed : 0);
            playersEl.innerHTML =
                `<span>${esc(lastState.blackPlayerName)} <span class="clock ${bActive ? 'active' : ''}">${fmt(bms)}</span></span>` +
                `<span>${esc(lastState.whitePlayerName)} <span class="clock ${wActive ? 'active' : ''}">${fmt(wms)}</span></span>`;
        }

        function onClick(sq) {
            if (finished || !gameId || pendingPromo || chess.turn() !== myColor) return;
            const p = chess.get(sq);
            if (sel === null) { if (p && p.color === myColor) { sel = sq; cells[sq].classList.add('sel'); } return; }
            const from = sel; cells[from]?.classList.remove('sel'); sel = null;
            if (from === sq) return;
            // Превращение пешки: показываем выбор фигуры (ферзь/ладья/слон/конь), ход шлём после выбора.
            const mover = chess.get(from);
            const isPromo = mover && mover.type === 'p' && (sq[1] === '8' || sq[1] === '1');
            if (isPromo) { askPromotion(from, sq); return; }
            commitMove(from, sq, null);
        }

        function commitMove(from, to, promotion) {
            let mv;
            try { mv = chess.move({ from, to, promotion: promotion || undefined }); } catch { mv = null; }
            if (!mv) { return; }
            render(null); // мгновенно показываем свой ход (без round-trip)
            conn.invoke('Move', gameId, from, to, mv.promotion || null)
                .then(r => { if (r && !r.accepted && r.state) render(r.state); }) // сервер отверг → ресинк
                .catch(() => {});
        }

        function askPromotion(from, to) {
            pendingPromo = { from, to };
            const color = chess.get(from).color;
            promoEl.innerHTML = ['q','r','b','n']
                .map(t => `<button class="promo-btn" data-p="${t}">${pieceImg({ color, type: t })}</button>`).join('');
            promoEl.querySelectorAll('button').forEach(b => b.onclick = () => {
                const t = b.dataset.p, mv = pendingPromo; pendingPromo = null; promoEl.hidden = true;
                commitMove(mv.from, mv.to, t);
            });
            promoEl.hidden = false;
        }

        const esc = (s) => String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
        const fmt = (ms) => { const t = Math.max(0, Math.floor(ms / 1000)); return String(Math.floor(t / 60)).padStart(2, '0') + ':' + String(t % 60).padStart(2, '0'); };
        const result = (r) => r === 1 ? L.whiteWon : r === 2 ? L.blackWon : r === 3 ? L.draw : '—';

        const conn = new signalR.HubConnectionBuilder()
            .withUrl(HUB + '/gamehub', { accessTokenFactory: getToken })
            .withAutomaticReconnect()
            .build();

        conn.on('GameState', s => render(s));
        conn.onreconnecting(() => statusEl.textContent = L.reconnecting);
        conn.onreconnected(async () => { // плохая сеть: после reconnect ресинхронизируемся с сервером
            if (gameId) { const s = await conn.invoke('JoinGame', gameId); if (s) render(s); }
        });

        buildBoard();
        setInterval(renderClocks, 250);
        await conn.start();
        statusEl.textContent = L.connected;

        findBtn.onclick = async () => {
            findBtn.disabled = true; statusEl.textContent = L.searching;
            try {
                const f = await conn.invoke('FindMatch', 300, 2);
                gameId = f.gameId; myColor = f.color === 0 ? 'w' : 'b'; flip = myColor === 'b';
                buildBoard();
                render(await conn.invoke('JoinGame', gameId));
            } catch { statusEl.textContent = L.notFound; findBtn.disabled = false; }
        };
        resignBtn.onclick = () => { if (gameId) conn.invoke('Resign', gameId).then(s => s && render(s)); };
    </script>
}

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    // JSON-строка локализованного значения для безопасной вставки в JS.
    private static string J(string key) => System.Text.Json.JsonSerializer.Serialize(Loc.T(key));
}

<style>
    .game { width: max-content; max-width: 100%; }
    .status { margin-bottom: .6rem; }
    .players { display: flex; flex-direction: column; gap: .35rem; margin-bottom: .75rem; font-size: 1.05rem; }
    .clock { font-variant-numeric: tabular-nums; padding: .1rem .5rem; border-radius: var(--r-sm, 6px); background: var(--surface-2, #eef0f3); font-weight: 600; margin-left: .4rem; }
    .clock.active { background: var(--accent, #2b6ef2); color: #fff; }

    .board-wrap { position: relative; width: min(92vw, 480px); }
    .board { display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr); width: 100%; aspect-ratio: 1 / 1; border-radius: 6px; overflow: hidden; box-shadow: var(--shadow-md, 0 8px 24px rgba(0,0,0,.12)); }
    .sq { position: relative; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .sq.light { background: #ecd6b3; }
    .sq.dark { background: #b58863; }
    .sq.hl.light { background: #cdd279; }
    .sq.hl.dark { background: #aaa23a; }
    .sq.chk { background: radial-gradient(circle at center, #ff8a7a 0%, #d23b2e 80%); }
    .sq.sel { outline: 3px solid var(--accent, #2b6ef2); outline-offset: -3px; }
    .coord { position: absolute; font-size: clamp(8px, 2.2vw, 11px); font-weight: 700; line-height: 1; user-select: none; pointer-events: none; }
    .coord.rank { top: 3px; left: 4px; }
    .coord.file { bottom: 2px; right: 4px; }
    .coord.on-light { color: #b58863; }
    .coord.on-dark { color: #ecd6b3; }
    .cp { width: 90%; height: 90%; display: block; }

    .promo { position: absolute; top: 35%; left: 50%; transform: translateX(-50%); display: flex; gap: .25rem; background: #fff; border: 1px solid var(--border, #d5d9e0); border-radius: 8px; padding: .4rem; box-shadow: 0 8px 24px rgba(0,0,0,.25); }
    /* hidden иначе проигрывает .promo{display:flex} (author > user-agent) — иначе пустой поповер виден точкой. */
    .promo[hidden] { display: none; }
    .promo-btn { width: 48px; height: 48px; padding: 4px; border: 1px solid var(--border, #d5d9e0); background: var(--surface-2, #f4f5f7); border-radius: 6px; cursor: pointer; }
    .promo-btn .cp { width: 100%; height: 100%; }

    .controls { display: flex; gap: .6rem; align-items: center; margin-top: .85rem; }
</style>
