@page "/playjs"
@inject IConfiguration Config

<PageTitle>Онлайн-партия (тонкий JS-клиент)</PageTitle>

@{
    var authed = HttpContext?.User?.Identity?.IsAuthenticated == true;
    var hub = Config["services:gameserver:https:0"] ?? Config["services:gameserver:http:0"] ?? "";
}

<h1>Онлайн-партия — тонкий клиент (PoC)</h1>

@if (!authed)
{
    <p>Войдите единым аккаунтом: <a href="/signin?returnUrl=/playjs">ChessSchool ID</a></p>
}
else
{
    <p class="hint">SSR-оболочка без .NET в браузере: chess.js (правила, оптимистичный ход) + SignalR прямо к игровому хабу. Откройте во второй вкладке другим аккаунтом.</p>
    <div id="status">Подключение…</div>
    <div id="players"></div>
    <div id="board" class="board"></div>
    <div class="controls">
        <button id="find">Найти соперника (блиц 5+2)</button>
        <button id="resign" hidden>Сдаться</button>
    </div>

    <script type="module">
        const HUB = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(hub));
        // Свежий токен берём с серверного эндпоинта (обновляется по refresh) — не вшиваем в страницу.
        const getToken = async () => {
            const r = await fetch('/api/game-token', { credentials: 'include' });
            return r.ok ? (await r.json()).access_token : '';
        };

        const { Chess } = await import('https://esm.sh/chess.js@1');
        const signalR = await import('https://esm.sh/@@microsoft/signalr@8');

        // SVG-фигуры (векторные, не зависят от шрифта).
        const PATHS = {
            p: '<path d="M22.5 11a4.5 4.5 0 0 0-2.7 8.1c-2.4 1.4-4.1 4-4.1 6.9 0 2.1 .9 4 2.4 5.4-3.2 1.7-7.6 5-7.6 9.6h23.8c0-4.6-4.4-7.9-7.6-9.6 1.5-1.4 2.4-3.3 2.4-5.4 0-2.9-1.7-5.5-4.1-6.9A4.5 4.5 0 0 0 22.5 11z"/>',
            r: '<path d="M11.5 40v-3.5l3-2V22l-2.2-2.2V12.5h5.2v3h4v-3h4v3h4v-3h5.2v7.3L36 22v12.5l3 2V40z"/>',
            n: '<path d="M22 10c2.2-.3 4 .7 5.4 2.4 3.6 3.7 5.6 9.8 5.6 17.6v6H13.5c0-6 1.2-9.6 4-12.6 1.6-1.7 3.4-2.7 5-4.2-2 1-4.3 2-6.3 1.2-1.6-.7-2-2.6-1.2-4.2-1.6 1.3-3.9 1.7-5.2-.2-1-1.5-.6-3.4 1-5.2 1.8-2 3.4-3 4.8-5.4.7-1.2 1.3-2.6 1.3-4 1.4.7 2.6 1.7 3.3 3z"/>',
            b: '<path d="M22.5 7a2.8 2.8 0 0 0-1.7 5c-3.3 1.9-5.8 5.5-5.8 9.6 0 3 1.3 5.3 3.3 6.9l-2.4 2.9c-2.1 2.1-3.4 3.5-3.4 5.6h20c0-2.1-1.3-3.5-3.4-5.6l-2.4-2.9c2-1.6 3.3-3.9 3.3-6.9 0-4.1-2.5-7.7-5.8-9.6A2.8 2.8 0 0 0 22.5 7z"/><path d="M22.5 14.5v8.5M18.5 19h8" fill="none" stroke-width="1.5"/>',
            q: '<path d="M11 37.5l-2.5-16.5 6.7 6.3 3.8-10.8 3.5 10.6 3.5-10.6 3.8 10.8 6.7-6.3L34 37.5z"/><path d="M11 37.5h23v3.5H11z"/><circle cx="8" cy="15.5" r="2.3"/><circle cx="22.5" cy="11" r="2.3"/><circle cx="37" cy="15.5" r="2.3"/>',
            k: '<path d="M22.5 7.5v6.5M19 10.5h7" fill="none" stroke-width="2.2"/><path d="M22.5 15.5c-5.7 0-9.8 4.1-9.8 9.2 0 3 1.5 5.4 3.8 7.1-2.7 1.8-4.8 4.1-4.8 7.7h21.6c0-3.6-2.1-5.9-4.8-7.7 2.3-1.7 3.8-4.1 3.8-7.1 0-5.1-4.1-9.2-9.8-9.2z"/>'
        };
        const svg = (p) => `<svg viewBox="0 0 45 45" class="cp ${p.color}" fill="currentColor" stroke="#111" stroke-width="1.3" stroke-linejoin="round">${PATHS[p.type]}</svg>`;

        const boardEl = document.getElementById('board');
        const statusEl = document.getElementById('status');
        const playersEl = document.getElementById('players');
        const findBtn = document.getElementById('find');
        const resignBtn = document.getElementById('resign');

        const chess = new Chess();
        let gameId = null, myColor = 'w', flip = false, sel = null, finished = false;
        const cells = {};

        const files = ['a','b','c','d','e','f','g','h'];
        function buildBoard() {
            boardEl.innerHTML = '';
            const ranks = flip ? [1,2,3,4,5,6,7,8] : [8,7,6,5,4,3,2,1];
            const cols = flip ? [...files].reverse() : files;
            for (const r of ranks) for (const f of cols) {
                const sq = f + r;
                const dark = (files.indexOf(f) + r) % 2 === 0;
                const el = document.createElement('div');
                el.className = 'sq ' + (dark ? 'dark' : 'light');
                el.dataset.sq = sq;
                el.onclick = () => onClick(sq);
                boardEl.appendChild(el);
                cells[sq] = el;
            }
        }

        function render(state) {
            if (state && state.fen) chess.load(state.fen);
            finished = state && state.status === 2;
            for (const f of files) for (let r = 1; r <= 8; r++) {
                const sq = f + r, el = cells[sq];
                const p = chess.get(sq);
                el.innerHTML = p ? svg(p) : '';
                el.classList.remove('hl', 'chk', 'sel');
            }
            if (state) {
                if (state.lastFrom && cells[state.lastFrom]) cells[state.lastFrom].classList.add('hl');
                if (state.lastTo && cells[state.lastTo]) cells[state.lastTo].classList.add('hl');
                if (state.checkSquare && cells[state.checkSquare]) cells[state.checkSquare].classList.add('chk');
                const wm = fmt(state.whiteMs), bm = fmt(state.blackMs);
                playersEl.innerHTML = `<div>♚ ${state.blackPlayerName} — ${bm}</div><div>♔ ${state.whitePlayerName} — ${wm}</div>`;
                statusEl.textContent = finished ? ('Партия завершена (' + result(state.result) + ')')
                    : (chess.turn() === myColor ? 'Ваш ход' : 'Ход соперника');
                resignBtn.hidden = finished;
            }
        }

        function onClick(sq) {
            if (finished || !gameId || chess.turn() !== myColor) return;
            const p = chess.get(sq);
            if (sel === null) { if (p && p.color === myColor) { sel = sq; cells[sq].classList.add('sel'); } return; }
            const from = sel; cells[from]?.classList.remove('sel'); sel = null;
            if (from === sq) return;
            // Оптимистичный ход: проверяем правила локально, сразу показываем, затем шлём на сервер.
            let mv;
            try { mv = chess.move({ from, to: sq, promotion: 'q' }); } catch { mv = null; }
            if (!mv) { if (p && p.color === myColor) { sel = sq; cells[sq].classList.add('sel'); } return; }
            render(null); // мгновенно показываем свой ход (без round-trip)
            conn.invoke('Move', gameId, from, sq, mv.promotion ? 'q' : null)
                .then(r => { if (r && !r.accepted && r.state) render(r.state); }) // сервер отверг → ресинк
                .catch(() => {});
        }

        const fmt = (ms) => { const t = Math.max(0, Math.floor(ms / 1000)); return String(Math.floor(t/60)).padStart(2,'0') + ':' + String(t%60).padStart(2,'0'); };
        const result = (r) => r === 1 ? 'победили белые' : r === 2 ? 'победили чёрные' : r === 3 ? 'ничья' : '—';

        const conn = new signalR.HubConnectionBuilder()
            .withUrl(HUB + '/gamehub', { accessTokenFactory: getToken })
            .withAutomaticReconnect()
            .build();

        conn.on('GameState', s => render(s));
        conn.onreconnecting(() => statusEl.textContent = 'Переподключение…');
        conn.onreconnected(async () => { // плохая сеть: после reconnect ресинхронизируемся с сервером
            if (gameId) { const s = await conn.invoke('JoinGame', gameId); if (s) render(s); }
        });

        buildBoard();
        await conn.start();
        statusEl.textContent = 'Подключено. Нажмите «Найти соперника».';

        findBtn.onclick = async () => {
            findBtn.disabled = true; statusEl.textContent = 'Ищем соперника…';
            try {
                const f = await conn.invoke('FindMatch', 300, 2);
                gameId = f.gameId; myColor = f.color === 0 ? 'w' : 'b'; flip = myColor === 'b';
                buildBoard();
                const s = await conn.invoke('JoinGame', gameId);
                render(s);
            } catch { statusEl.textContent = 'Соперник не найден. Попробуйте ещё раз.'; findBtn.disabled = false; }
        };
        resignBtn.onclick = () => { if (gameId) conn.invoke('Resign', gameId).then(s => s && render(s)); };
    </script>

    <style>
        .hint { color: #666; max-width: 640px; }
        .board { display: grid; grid-template-columns: repeat(8, 56px); grid-template-rows: repeat(8, 56px); width: 448px; border: 2px solid #333; margin: .5rem 0; }
        .sq { display: flex; align-items: center; justify-content: center; cursor: pointer; }
        .sq.light { background: #f0d9b5; } .sq.dark { background: #b58863; }
        .sq.hl { background: #cdd279; } .sq.dark.hl { background: #aaa23a; }
        .sq.chk { background: radial-gradient(circle at center, #ff8a7a 0%, #d23b2e 80%); }
        .sq.sel { outline: 3px solid #1b6ec2; outline-offset: -3px; }
        .cp { width: 84%; height: 84%; }
        .cp.w { color: #f4f4f4; } .cp.b { color: #1f1f1f; }
        #players { display: flex; flex-direction: column; gap: .2rem; font-size: 1.1rem; margin: .3rem 0; }
        .controls { display: flex; gap: .5rem; }
        .controls button { padding: .4rem .9rem; }
    </style>
}

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
}
