@page "/p/{Token}"
@using ChessSchool.Web
@inject SchoolApiClient Api

<PageTitle>@(_profile?.Student.DisplayName ?? Loc.T("profile.fallback"))</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (_loaded && _profile is null)
{
    <div class="alert alert-warning">@Loc.T("public.invalid")</div>
}
else if (_profile is null)
{
    <p><em>@Loc.T("loading")</em></p>
}
else
{
    <p class="text-muted">@Loc.T("public.sub")</p>
    <ProfileView Profile="_profile" />
}

@code {
    [Parameter] public string Token { get; set; } = "";
    private StudentProfileDto? _profile;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _profile = await Api.GetSharedAsync(Token);
        _loaded = true;
    }
}
