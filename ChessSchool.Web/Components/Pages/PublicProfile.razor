@page "/p/{Token}"
@inject SchoolApiClient Api

<PageTitle>@(_profile?.Student.DisplayName ?? "Профиль ученика")</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (_loaded && _profile is null)
{
    <div class="alert alert-warning">Ссылка недействительна или истекла.</div>
}
else if (_profile is null)
{
    <p><em>Загрузка…</em></p>
}
else
{
    <p class="text-muted">Профиль ученика для родителя (только просмотр).</p>
    <ProfileView Profile="_profile" />
}

@code {
    [Parameter] public string Token { get; set; } = "";
    private StudentProfileDto? _profile;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _profile = await Api.GetSharedAsync(Token);
        _loaded = true;
    }
}
