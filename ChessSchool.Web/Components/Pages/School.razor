@page "/school"
@rendermode InteractiveServer
@attribute [Authorize]
@using ChessSchool.Web
@using Microsoft.AspNetCore.Authorization
@inject SchoolApiClient Api
@inject NavigationManager Nav

<PageTitle>@Loc.T("school.pagetitle")</PageTitle>

<div class="section-head">
    <div>
        <h1>@Loc.T("school.h1")</h1>
        <p class="text-secondary mb-0">@Loc.T("school.sub")</p>
    </div>
</div>

<div class="card">
    <div class="add-row">
        <input @bind="_newName" placeholder="@Loc.T("school.newname")" class="input" />
        <button class="btn btn-primary" @onclick="AddStudent" disabled="@string.IsNullOrWhiteSpace(_newName)">@Loc.T("school.add")</button>
    </div>

    @if (_students is null)
    {
        <p class="text-muted"><em>@Loc.T("loading")</em></p>
    }
    else
    {
        <table class="table hover">
            <thead>
                <tr><th>@Loc.T("school.col.student")</th><th>@Loc.T("school.col.rating")</th><th>@Loc.T("school.col.games")</th><th>@Loc.T("school.col.winrate")</th><th>@Loc.T("school.col.account")</th><th>@Loc.T("school.col.parent")</th></tr>
            </thead>
            <tbody>
                @foreach (var s in _students)
                {
                    <tr>
                        <td><a href="students/@s.Id">@s.DisplayName</a></td>
                        <td><strong>@s.Rating</strong> <span class="rd">±@s.RatingDeviation</span></td>
                        <td>@s.GamesPlayed</td>
                        <td>@s.WinRate%</td>
                        <td>
                            @if (s.AccountLinked)
                            {
                                <span class="badge badge-success">@Loc.T("school.linked")</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-ghost" @onclick="() => _linkingId = s.Id">@Loc.T("school.link")</button>
                            }
                        </td>
                        <td><button class="btn btn-sm btn-ghost" @onclick="() => Share(s.Id)">@Loc.T("school.share")</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_linkingId is { } lid)
    {
        <div class="link-panel">
            <span>@Loc.T("school.emaillabel")</span>
            <input @bind="_linkEmail" placeholder="player@example.com" class="form-control" />
            <button class="btn btn-primary btn-sm" @onclick="() => LinkAccount(lid)">@Loc.T("school.link")</button>
            <button class="btn btn-link btn-sm" @onclick="() => _linkingId = null">@Loc.T("school.cancel")</button>
            @if (_linkError is not null) { <span class="text-danger">@_linkError</span> }
        </div>
    }

    @if (_shareUrl is not null)
    {
        <div class="alert alert-info mt-2">
            @Loc.T("school.shareparent") <a href="@_shareUrl">@_shareUrl</a>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<StudentDto>? _students;
    private Guid _schoolId;
    private Guid _groupId;
    private string? _sub;
    private string _newName = "";
    private string? _shareUrl;
    private Guid? _linkingId;
    private string _linkEmail = "";
    private string? _linkError;

    protected override async Task OnInitializedAsync()
    {
        // sub из AuthState (работает и в prerender, и в интерактивном контуре Blazor Server).
        _sub = AuthState is null ? null : (await AuthState).User.FindFirst("sub")?.Value;
        if (_sub is null) return; // [Authorize] не пускает анонима — это лишь страховка
        var my = await Api.GetOrCreateMySchoolAsync(_sub);
        if (my is null) return;
        _schoolId = my.SchoolId;
        _groupId = my.GroupId;
        await Load();
    }

    private async Task Load() => _students = await Api.GetStudentsAsync(_schoolId, _sub!);

    private async Task AddStudent()
    {
        await Api.CreateStudentAsync(_schoolId, new CreateStudentRequest(_groupId, _newName.Trim(), null), _sub!);
        _newName = "";
        await Load();
    }

    private async Task Share(Guid studentId)
    {
        var link = await Api.CreateShareAsync(studentId, _sub!);
        if (link is not null)
            _shareUrl = new Uri(new Uri(Nav.BaseUri), link.Url).ToString();
    }

    private async Task LinkAccount(Guid studentId)
    {
        _linkError = null;
        var updated = await Api.LinkAccountAsync(studentId, _linkEmail.Trim(), _sub!);
        if (updated is null) { _linkError = Loc.T("school.linkerr"); return; }
        _linkingId = null;
        _linkEmail = "";
        await Load();
    }
}

<style>
    .add-row { display: flex; gap: .5rem; max-width: 480px; margin-bottom: 1.25rem; }
    .rd { color: var(--muted); font-size: .8rem; }
    .link-panel { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; margin: 1rem 0 0; padding: .85rem; background: var(--surface-2); border-radius: var(--r-md); max-width: 640px; }
    .link-panel input { max-width: 260px; }
</style>
