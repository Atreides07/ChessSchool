@page "/school"
@rendermode InteractiveServer
@attribute [Authorize]
@using ChessSchool.Web
@using Microsoft.AspNetCore.Authorization
@inject SchoolApiClient Api
@inject NavigationManager Nav

<PageTitle>@Loc.T("school.pagetitle")</PageTitle>

<div class="section-head">
    <div>
        <h1>@Loc.T("school.h1")</h1>
        <p class="text-secondary mb-0">@Loc.T("school.sub")</p>
    </div>
</div>

<div class="card">
    <div class="add-row">
        <input @bind="_newName" @bind:event="oninput" placeholder="@Loc.T("school.newname")" class="input" />
        <input type="date" @bind="_newBirth" title="@Loc.T("school.birthdate")" class="input input-date" />
        <button class="btn btn-primary" @onclick="AddStudent" disabled="@string.IsNullOrWhiteSpace(_newName)">@Loc.T("school.add")</button>
    </div>

    @if (_students is null)
    {
        <p class="text-muted"><em>@Loc.T("loading")</em></p>
    }
    else
    {
        <div class="list-tools">
            <input @bind="_search" @bind:event="oninput" placeholder="@Loc.T("school.search")" class="input search" />
            <span class="text-muted count">@View.Count / @_students.Count</span>
        </div>

        @if (View.Count == 0)
        {
            <p class="text-muted mt-2"><em>@(_students.Count == 0 ? Loc.T("school.empty") : Loc.T("school.nomatch"))</em></p>
        }
        else
        {
            <table class="table hover">
                <thead>
                    <tr>
                        <th><button class="th-sort" @onclick='() => SetSort("name")'>@Loc.T("school.col.student")@Caret("name")</button></th>
                        <th><button class="th-sort" @onclick='() => SetSort("rating")'>@Loc.T("school.col.rating")@Caret("rating")</button></th>
                        <th><button class="th-sort" @onclick='() => SetSort("games")'>@Loc.T("school.col.games")@Caret("games")</button></th>
                        <th><button class="th-sort" @onclick='() => SetSort("winrate")'>@Loc.T("school.col.winrate")@Caret("winrate")</button></th>
                        <th>@Loc.T("school.col.account")</th>
                        <th>@Loc.T("school.col.parent")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in View)
                    {
                        <tr>
                            <td><a href="students/@s.Id">@s.DisplayName</a></td>
                            <td><strong>@s.Rating</strong> <span class="rd">±@s.RatingDeviation</span></td>
                            <td>@s.GamesPlayed</td>
                            <td>@s.WinRate%</td>
                            <td>
                                @if (s.AccountLinked)
                                {
                                    <span class="badge badge-success">@Loc.T("school.linked")</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-ghost" @onclick="() => _linkingId = s.Id">@Loc.T("school.link")</button>
                                }
                            </td>
                            <td><button class="btn btn-sm btn-ghost" @onclick="() => OpenShares(s.Id)">@Loc.T("school.share")</button></td>
                            <td><button class="btn btn-sm btn-ghost" title="@Loc.T("school.edit")" @onclick="() => StartEdit(s)">✎</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (_editingId is { } eid)
    {
        <div class="link-panel">
            <span>@Loc.T("school.edit"):</span>
            <input @bind="_editName" placeholder="@Loc.T("school.newname")" class="form-control" />
            <input type="date" @bind="_editBirth" title="@Loc.T("school.birthdate")" class="form-control" />
            <button class="btn btn-primary btn-sm" @onclick="() => SaveEdit(eid)" disabled="@string.IsNullOrWhiteSpace(_editName)">@Loc.T("school.save")</button>
            <button class="btn btn-link btn-sm" @onclick="CancelEdit">@Loc.T("school.cancel")</button>
        </div>
    }

    @if (_linkingId is { } lid)
    {
        <div class="link-panel">
            <span>@Loc.T("school.emaillabel")</span>
            <input @bind="_linkEmail" placeholder="player@example.com" class="form-control" />
            <button class="btn btn-primary btn-sm" @onclick="() => LinkAccount(lid)">@Loc.T("school.link")</button>
            <button class="btn btn-link btn-sm" @onclick="() => _linkingId = null">@Loc.T("school.cancel")</button>
            @if (_linkError is not null) { <span class="text-danger">@_linkError</span> }
        </div>
    }

    @if (_sharingId is { } sid)
    {
        <div class="link-panel share-panel">
            <div class="share-head">
                <span>@Loc.T("school.shareparent")</span>
                <button class="btn btn-primary btn-sm" @onclick="() => CreateShare(sid)">@Loc.T("school.sharenew")</button>
                <button class="btn btn-link btn-sm" @onclick="() => _sharingId = null">@Loc.T("school.cancel")</button>
            </div>
            @if (_shares.Count == 0)
            {
                <p class="text-muted mb-0"><em>@Loc.T("school.shareempty")</em></p>
            }
            else
            {
                <ul class="share-list">
                    @foreach (var l in _shares)
                    {
                        var abs = new Uri(new Uri(Nav.BaseUri), l.Url).ToString();
                        <li class="@(l.Active ? "" : "inactive")">
                            @if (l.Active)
                            {
                                <a href="@abs">@abs</a>
                                <span class="share-state ok">@Loc.T("school.shareactive")</span>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeShare(sid, l.Token)">@Loc.T("school.sharerevoke")</button>
                            }
                            else
                            {
                                <span class="share-url-dead">@abs</span>
                                <span class="share-state dead">@(l.Revoked ? Loc.T("school.sharerevoked") : Loc.T("school.shareexpired"))</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<StudentDto>? _students;
    private Guid _schoolId;
    private Guid _groupId;
    private string? _sub;
    private string _newName = "";
    private DateOnly? _newBirth;
    private Guid? _sharingId;
    private IReadOnlyList<ShareLinkInfoDto> _shares = [];
    private Guid? _linkingId;
    private string _linkEmail = "";
    private string? _linkError;

    // Поиск/сортировка — на клиенте поверх загруженного списка (быстрый отклик без round-trip к API).
    private string _search = "";
    private string _sortKey = "rating";
    private bool _sortDesc = true;

    // Инлайн-редактирование.
    private Guid? _editingId;
    private string _editName = "";
    private DateOnly? _editBirth;

    private IReadOnlyList<StudentDto> View
    {
        get
        {
            if (_students is null) return [];
            IEnumerable<StudentDto> q = _students;
            var term = _search.Trim();
            if (term.Length > 0)
                q = q.Where(s => s.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase));
            q = _sortKey switch
            {
                "name" => q.OrderBy(s => s.DisplayName, StringComparer.CurrentCultureIgnoreCase),
                "games" => q.OrderBy(s => s.GamesPlayed),
                "winrate" => q.OrderBy(s => s.WinRate),
                _ => q.OrderBy(s => s.Rating),
            };
            if (_sortDesc) q = q.Reverse();
            return q.ToList();
        }
    }

    private void SetSort(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;
        else { _sortKey = key; _sortDesc = key != "name"; } // имя — по возрастанию, числа — по убыванию по умолчанию
    }

    private string Caret(string key) => _sortKey != key ? "" : _sortDesc ? " ▾" : " ▴";

    protected override async Task OnInitializedAsync()
    {
        // sub из AuthState (работает и в prerender, и в интерактивном контуре Blazor Server).
        _sub = AuthState is null ? null : (await AuthState).User.FindFirst("sub")?.Value;
        if (_sub is null) return; // [Authorize] не пускает анонима — это лишь страховка
        var my = await Api.GetOrCreateMySchoolAsync(_sub);
        if (my is null) return;
        _schoolId = my.SchoolId;
        _groupId = my.GroupId;
        await Load();
    }

    private async Task Load() => _students = await Api.GetStudentsAsync(_schoolId, _sub!);

    private async Task AddStudent()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        await Api.CreateStudentAsync(_schoolId, new CreateStudentRequest(_groupId, _newName.Trim(), _newBirth), _sub!);
        _newName = "";
        _newBirth = null;
        await Load();
    }

    private void StartEdit(StudentDto s)
    {
        _editingId = s.Id;
        _editName = s.DisplayName;
        _editBirth = s.BirthDate;
        _linkingId = null; // не показывать две панели сразу
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEdit(Guid studentId)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        await Api.UpdateStudentAsync(studentId, new UpdateStudentRequest(_editName.Trim(), _editBirth), _sub!);
        _editingId = null;
        await Load();
    }

    private async Task OpenShares(Guid studentId)
    {
        _sharingId = studentId;
        _linkingId = null;
        _editingId = null;
        _shares = await Api.GetSharesAsync(studentId, _sub!);
    }

    private async Task CreateShare(Guid studentId)
    {
        await Api.CreateShareAsync(studentId, _sub!);
        _shares = await Api.GetSharesAsync(studentId, _sub!);
    }

    private async Task RevokeShare(Guid studentId, string token)
    {
        await Api.RevokeShareAsync(studentId, token, _sub!);
        _shares = await Api.GetSharesAsync(studentId, _sub!);
    }

    private async Task LinkAccount(Guid studentId)
    {
        _linkError = null;
        var updated = await Api.LinkAccountAsync(studentId, _linkEmail.Trim(), _sub!);
        if (updated is null) { _linkError = Loc.T("school.linkerr"); return; }
        _linkingId = null;
        _linkEmail = "";
        await Load();
    }
}

<style>
    .add-row { display: flex; gap: .5rem; max-width: 640px; margin-bottom: 1rem; flex-wrap: wrap; }
    .input-date { max-width: 170px; }
    .list-tools { display: flex; align-items: center; gap: .75rem; margin: .25rem 0 1rem; }
    .list-tools .search { max-width: 320px; }
    .list-tools .count { font-size: .85rem; white-space: nowrap; }
    .th-sort { background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; font-weight: inherit; }
    .th-sort:hover { color: var(--accent); }
    .rd { color: var(--muted); font-size: .8rem; }
    .link-panel { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; margin: 1rem 0 0; padding: .85rem; background: var(--surface-2); border-radius: var(--r-md); max-width: 640px; }
    .link-panel input { max-width: 260px; }
    .share-panel { flex-direction: column; align-items: stretch; max-width: 720px; }
    .share-head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .share-list { list-style: none; margin: .5rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .4rem; }
    .share-list li { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
    .share-list li.inactive { opacity: .6; }
    .share-url-dead { text-decoration: line-through; color: var(--muted); word-break: break-all; }
    .share-state { font-size: .78rem; padding: .1rem .45rem; border-radius: var(--r-sm); }
    .share-state.ok { background: var(--success-bg, #e6f4ea); color: var(--success, #1a7f37); }
    .share-state.dead { background: var(--surface-2); color: var(--muted); }
</style>
