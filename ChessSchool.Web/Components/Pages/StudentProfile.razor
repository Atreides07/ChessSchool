@page "/students/{Id:guid}"
@attribute [Authorize]
@using ChessSchool.Web
@using Microsoft.AspNetCore.Authorization
@inject SchoolApiClient Api

<PageTitle>@(_profile?.Student.DisplayName ?? Loc.T("profile.fallback"))</PageTitle>

@if (!_loaded)
{
    <p><em>@Loc.T("loading")</em></p>
}
else if (_profile is null)
{
    <p><em>@Loc.T("profile.notfound")</em></p>
    <p><a href="school">@Loc.T("profile.tolist")</a></p>
}
else
{
    <div class="profile-actions no-print">
        <a href="school">@Loc.T("profile.tolist")</a>
        <button class="btn btn-ghost btn-sm" onclick="window.print()">🖨 @Loc.T("profile.print")</button>
    </div>
    <ProfileView Profile="_profile" />
    <p class="no-print"><a href="school">@Loc.T("profile.tolist")</a></p>
}

<style>
    .profile-actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    @@media print {
        .ds-topbar, .no-print { display: none !important; }
        body { background: #fff; }
        main, .page, article { margin: 0 !important; padding: 0 !important; }
    }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter] public Guid Id { get; set; }
    private StudentProfileDto? _profile;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        // Владение проверяет ApiService по acting-sub: чужой ученик → 403 → профиль null → «не найдено».
        var sub = AuthState is null ? null : (await AuthState).User.FindFirst("sub")?.Value;
        if (sub is not null)
            _profile = await Api.GetProfileAsync(Id, sub);
        _loaded = true;
    }
}
