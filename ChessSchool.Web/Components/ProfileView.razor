@* Профиль ученика: рейтинг, график, последние партии. Используется в ЛК и на публичной странице. *@

<h1>@Profile.Student.DisplayName</h1>
<div class="stats">
    <div class="stat"><span>Рейтинг</span><strong>@Profile.Student.Rating</strong></div>
    <div class="stat"><span>Партий</span><strong>@Profile.Student.GamesPlayed</strong></div>
    <div class="stat"><span>Побед</span><strong>@Profile.Student.Wins</strong></div>
    <div class="stat"><span>% побед</span><strong>@Profile.Student.WinRate%</strong></div>
</div>

<h2>Динамика рейтинга</h2>
<RatingChart Points="Profile.RatingHistory" />

<h2>Последние партии</h2>
@if (Profile.RecentGames.Count == 0)
{
    <p class="text-muted">Партий пока нет.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Дата</th><th>Цвет</th><th>Соперник</th><th>Итог</th><th>± рейтинг</th></tr></thead>
        <tbody>
            @foreach (var g in Profile.RecentGames)
            {
                <tr>
                    <td>@g.PlayedAt.LocalDateTime.ToString("dd.MM.yyyy")</td>
                    <td>@(g.Color == PieceColor.White ? "Белые" : "Чёрные")</td>
                    <td>@g.OpponentName</td>
                    <td>@ResultText(g)</td>
                    <td>@(g.RatingChange > 0 ? "+" : "")@g.RatingChange</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public StudentProfileDto Profile { get; set; } = default!;

    private static string ResultText(GameSummaryDto g)
    {
        bool isWhite = g.Color == PieceColor.White;
        return g.Result switch
        {
            GameResult.Draw => "Ничья",
            GameResult.WhiteWins => isWhite ? "Победа" : "Поражение",
            GameResult.BlackWins => isWhite ? "Поражение" : "Победа",
            _ => "—"
        };
    }
}

<style>
    .stats { display: flex; gap: 1.5rem; margin: 1rem 0; }
    .stat { display: flex; flex-direction: column; }
    .stat span { color: #666; font-size: .85rem; }
    .stat strong { font-size: 1.5rem; }
</style>
