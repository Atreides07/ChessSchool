@inject NavigationManager Nav

@* Неавторизованный на [Authorize]-странице → полный переход на /signin (challenge OIDC, см. MapSsoEndpoints),
   с возвратом на исходный URL после входа. *@
@code {
    protected override void OnInitialized()
    {
        var returnUrl = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        Nav.NavigateTo($"/signin?returnUrl={returnUrl}", forceLoad: true);
    }
}
