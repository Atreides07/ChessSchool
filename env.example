# Шаблон переменных окружения ChessSchool.
# Скопируйте в .env (НЕ коммитьте .env) или задайте через user-secrets / окружение.
# Для локального запуска через .NET Aspire значения по умолчанию уже подставляются в AppHost —
# этот файл нужен для прод-конфигурации и переопределений.

# --- Общий секрет для server-to-server вызовов GameServer -> ApiService (архивация партий) ---
# AppHost локально подставляет "dev-internal-key". В проде задайте стойкое случайное значение.
InternalApiKey=

# --- JWT / сервис авторизации (IdP) ---
# Аудитория токенов (должна совпадать у Auth и валидаторов).
Jwt__Audience=chessschool-api
# Путь к RSA-ключу подписи токенов. В проде — секрет из KMS/Key Vault, НЕ файл в репозитории.
Jwt__KeyPath=

# --- Строки подключения (локально по умолчанию SQLite-файлы; в проде — PostgreSQL) ---
ConnectionStrings__auth=
ConnectionStrings__school=

# --- Прод: кластеризация Orleans и backplane SignalR (локально не требуется) ---
# Redis для Orleans clustering и SignalR backplane при горизонтальном масштабе.
# ConnectionStrings__redis=
