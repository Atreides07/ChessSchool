# Шаблон переменных окружения ChessSchool.
# Скопируйте в .env (НЕ коммитьте .env) или задайте через user-secrets / окружение.
# Для локального запуска через .NET Aspire значения по умолчанию уже подставляются в AppHost —
# этот файл нужен для прод-конфигурации и переопределений.
#
# В .NET двойное подчёркивание "__" в имени переменной = вложенная секция конфига
# (Database__Provider ⇄ "Database:Provider").

# --- Общий секрет для server-to-server вызовов (GameServer/Web -> ApiService, архивация партий) ---
# Читают ApiService, GameServer, Auth (заголовок X-Internal-Key). Локально AppHost подставляет
# "dev-internal-key". В проде задайте стойкое случайное значение.
InternalApiKey=

# --- Базы данных (PostgreSQL для всех окружений) ---
# Локально connection strings подставляет Aspire (поднимает контейнер Postgres — нужен Docker/Podman).
# Имена "authdb"/"schooldb" соответствуют GetConnectionString(...) в Auth/ApiService
# (отличаются от имён проектов — resource-имена Aspire уникальны).
# В проде укажите строки подключения к управляемому PostgreSQL. Схема накатывается EF-миграциями
# на старте сервиса (db.Database.Migrate()).
ConnectionStrings__authdb=
ConnectionStrings__schooldb=

# --- Валидация JWT ресурс-серверами ---
# Аудитория токенов; должна совпадать у Auth (issuer) и валидаторов (GameServer/ApiService/Web).
# Issuer/authority берётся через service discovery (services:auth:*), отдельной переменной не требует.
# Подпись токенов в проде — сертификат OpenIddict из защищённого хранилища (KMS/Key Vault),
# а не файл-ключ в репозитории (локально OpenIddict использует dev-сертификат).
Jwt__Audience=chessschool-api

# --- SSO / OIDC: подключение веб-приложений к IdP ---
# Идентификатор клиента, под которым веб-приложение логинится в Auth (читает ChessSchool.WebAuth).
# Локально AppHost задаёт chessschool-web (Web) и arena-web (Arena).
Sso__ClientId=chessschool-web
# Базовый адрес каждого клиента = его разрешённый redirect_uri (сидится в Auth.ClientSeeder).
# Локально AppHost подставляет фактические внешние URL из дашборда; в проде укажите публичные адреса.
Sso__Clients__chessschool-web=
Sso__Clients__arena-web=

# --- CORS игрового сервера (тонкий браузерный SignalR-клиент) ---
# В Development GameServer разрешает любой origin (порты под Aspire динамические).
# В проде — строгий список доменов фронта (any-origin + credentials небезопасно).
# Через переменную окружения список задаётся индексами: Cors__Origins__0, Cors__Origins__1, ...
# Cors__Origins__0=https://app.chessschool.example
# Cors__Origins__1=https://arena.chessschool.example

# --- Админка Arena (/admin: управление трансляциями) ---
# Список e-mail администраторов через запятую (заголовок доступа к разделу /admin).
# Пусто в Development = админом считается любой аутентифицированный пользователь (удобство dev);
# пусто вне Development = доступ к /admin закрыт всем (безопасный дефолт). В проде укажите явно.
# Admin__Emails=admin@chessschool.example,owner@chessschool.example

# --- Боты Arena (Stockfish) ---
# Путь к бинарю UCI-движка. По умолчанию ищется "stockfish" в PATH (локально: brew install stockfish).
# Нет бинаря → бот ходит случайным легальным ходом (graceful fallback).
# Engine__Path=/opt/homebrew/bin/stockfish

# --- Прод: кластеризация Orleans и backplane SignalR (локально не требуется) ---
# Redis для Orleans clustering и SignalR backplane при горизонтальном масштабе.
# ConnectionStrings__redis=

# --- Телеметрия (опционально; OpenTelemetry в ChessSchool.ServiceDefaults) ---
# OTLP-эндпоинт коллектора (локально его задаёт дашборд Aspire).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Либо экспорт в Azure Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
