<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChessSchool.ArenaLoadTest</RootNamespace>
    <AssemblyName>ChessSchool.ArenaLoadTest</AssemblyName>
    <!-- Тонкий Razor SG отключён в Arena (грабля #16); тут только грейны/сервисы, но зависим от проекта. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Реальный грейн турнира + его сервисы — измеряем настоящую стоимость, а не заглушку. -->
    <ProjectReference Include="..\..\ChessSchool.Arena\ChessSchool.Arena.csproj" />
    <!-- Тот же in-proc тест-силос Orleans, что и в ChessSchool.Tests. -->
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.2.1" />
    <!-- Та же шахматная либа, что в грейне (ChessGame) — генерим ЛЕГАЛЬНЫЕ ходы для сценария PLAY. -->
    <PackageReference Include="Gera.Chess" Version="1.2.0" />
  </ItemGroup>

</Project>
